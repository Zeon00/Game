local function getItems(kit)
    local result = {}

    for _, item in ipairs(kit.Shop.List) do
        if item.Stock then
            table.insert(result, item)
        end
    end

    table.sort(result, function(a, b)
        local ai = PriorityIndex[a.Key] or 999
        local bi = PriorityIndex[b.Key] or 999
        return ai < bi
    end)

    return result
end

local CurrentKit
local CurrentItems = {}
local CurrentSlot

local function setupKit(kit)
    if CurrentKit == kit then
        return
    end

    CurrentKit = kit
    CurrentItems = getItems(kit)
    CurrentSlot = nil
    Rows = {}

    for _, child in ipairs(List:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    for index, item in ipairs(CurrentItems) do
        createRow(item.Key, index)
    end
end

--============================================================
-- TIMER / LIVE DATA
--============================================================

local function formatTime(seconds)
    seconds = math.max(0, math.floor(seconds))

    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local secs = seconds % 60

    if hours > 0 then
        return string.format("%02d:%02d:%02d", hours, minutes, secs)
    end

    return string.format("%02d:%02d", minutes, secs)
end

local function getData()
    local kit = EventKit.running()

    if not kit then
        return nil
    end

    setupKit(kit)

    local now = workspace:GetServerTimeNow()
    local state = EventKit.state(Player)
    local buys = state.Buys

    local slot, startTime, nextTime = ShopAPI.slot(kit, now)
    local stock = ShopAPI.stock(kit, slot)

    return {
        Kit = kit,
        Now = now,
        State = state,
        Buys = buys,
        Slot = slot,
        StartTime = startTime,
        NextTime = nextTime,
        Stock = stock
    }
end

local function updateDisplay(data)
    if not data then
        Timer.Text = "EVENT NOT ACTIVE"
        EventStatus.Text = "EVENT: NOT RUNNING"
        return
    end

    Timer.Text = "NEXT RESTOCK: " ..
        formatTime(data.NextTime - data.Now)

    EventStatus.Text = "EVENT: ACTIVE | SLOT: " ..
        tostring(data.Slot)

    local tokens = tonumber(Player:GetAttribute("EvTokens"))
        or tonumber(data.State.Tokens)
        or 0

    for _, item in ipairs(CurrentItems) do
        local row = Rows[item.Key]

        if row then
            local left = ShopAPI.left(
                data.Kit,
                data.Buys,
                item.Key,
                data.Now
            )

            local price = tonumber(item.Price) or 0

            row.Stock.Text = tostring(left) ..
                " LEFT | " .. tostring(price) .. " T"

            if left > 0 and tokens >= price then
                row.Stock.TextColor3 = Color3.fromRGB(100, 255, 140)
            elseif left > 0 then
                row.Stock.TextColor3 = Color3.fromRGB(255, 190, 90)
            else
                row.Stock.TextColor3 = Color3.fromRGB(255, 105, 105)
            end

            row.Frame.BackgroundColor3 =
                left > 0 and Color3.fromRGB(43, 55, 46)
                or Color3.fromRGB(48, 46, 55)
        end
    end
end

--============================================================
-- ORIGINAL AUTO BUY FUNCTION
-- REMOTE + BUY FLOW KEPT FROM YOUR WORKING SCRIPT
--============================================================

local LastAttempt = {}

local function attemptBuy(data)
    if BUSY or not AUTO_BUY or not data then
        return
    end

    local tokens = tonumber(Player:GetAttribute("EvTokens"))
        or tonumber(data.State.Tokens)
        or 0

    for _, item in ipairs(CurrentItems) do
        local key = item.Key
        local price = tonumber(item.Price) or 0

        local left = ShopAPI.left(
            data.Kit,
            data.Buys,
            key,
            data.Now
        )

        local attemptKey = tostring(data.Slot) .. ":" .. key
        local last = LastAttempt[attemptKey] or 0

        if left > 0 and tokens >= price
        and data.Stock[key] and data.Stock[key] > 0 then

            if os.clock() - last >= BUY_DELAY then
                BUSY = true
                LastAttempt[attemptKey] = os.clock()

                Status.Text = "Buying: " .. key

                task.spawn(function()
                    local success, result = pcall(function()
                        return Request:InvokeServer("EventBuy", key)
                    end)

                    if success and result ~= false then
                        Status.Text = "Purchase requested: " .. key
                    else
                        LastAttempt[attemptKey] = os.clock() + FAIL_DELAY
                        Status.Text = "Buy failed: " .. key

                        if not success then
                            warn("[Lantern AutoBuy]", result)
                        end
                    end

                    task.wait(BUY_DELAY)
                    BUSY = false
                end)

                return
            end
        end
    end

    Status.Text = "Auto Buy: Checking stock..."
end

--============================================================
-- TELEPORT HELPERS
--============================================================

local function getRoot()
    local character = Player.Character
    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

local function teleportToShop()
    local character = Player.Character
    local root = getRoot()

    if not character or not root then
        return nil, nil
    end

    local originalCFrame = root.CFrame

    character:PivotTo(CFrame.new(SHOP_POSITION))
    task.wait(0.35)

    if not getRoot() then
        return nil, nil
    end

    return originalCFrame, character
end

local function hasAffordableStock(data)
    if not data then
        return false
    end

    local state = EventKit.state(Player)
    local tokens = tonumber(Player:GetAttribute("EvTokens"))
        or tonumber(state.Tokens)
        or 0

    for _, item in ipairs(CurrentItems) do
        local left = ShopAPI.left(
            data.Kit,
            state.Buys,
            item.Key,
            workspace:GetServerTimeNow()
        )

        local price = tonumber(item.Price) or 0

        if left > 0 and tokens >= price
        and (tonumber(data.Stock[item.Key]) or 0) > 0 then
            return true
        end
    end

    return false
end

--============================================================
-- RESTOCK CYCLE
--============================================================

local function restockCycle(oldSlot)
    if RESTOCK_BUSY or not AUTO_BUY or not RUNNING then
        return
    end

    RESTOCK_BUSY = true
    Status.Text = "TELEPORTING TO SHOP..."

    local originalCFrame, originalCharacter = teleportToShop()

    if not originalCFrame then
        Status.Text = "TELEPORT FAILED"
        RESTOCK_BUSY = false
        return
    end

    Status.Text = "WAITING FOR NEW RESTOCK..."

    local newData
    local waitDeadline = os.clock() + SHOP_WAIT_TIMEOUT

    repeat
        task.wait(0.1)

        local ok, data = pcall(getData)

        if ok and data and data.Slot ~= oldSlot then
            newData = data
            break
        end
    until os.clock() >= waitDeadline or not RUNNING

    if newData and RUNNING and AUTO_BUY then
        Status.Text = "NEW STOCK DETECTED"

        -- Reset attempts only for the new slot.
        for key in pairs(LastAttempt) do
            if string.sub(key, 1, #tostring(newData.Slot) + 1)
                == tostring(newData.Slot) .. ":" then
                LastAttempt[key] = nil
            end
        end

        local buyDeadline = os.clock() + BUY_TIMEOUT

        while RUNNING and AUTO_BUY
        and os.clock() < buyDeadline do

            local ok, freshData = pcall(getData)

            if ok and freshData and freshData.Slot == newData.Slot then
                newData = freshData
                updateDisplay(newData)

                if not hasAffordableStock(newData) then
                    break
                end

                if not BUSY then
                    attemptBuy(newData)
                end
            end

            task.wait(0.15)
        end

        Status.Text = "RESTOCK BUY CYCLE FINISHED"
        LastAttempt["Handled:" .. tostring(newData.Slot)] = os.clock()
    else
        Status.Text = "NEW RESTOCK NOT DETECTED"
    end

    -- Return only if the same character is still present.
    if RUNNING and Player.Character == originalCharacter then
        originalCharacter:PivotTo(originalCFrame)
    end

    RESTOCK_BUSY = false
end

