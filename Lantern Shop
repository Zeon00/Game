--============================================================
-- MAIN LOOP
--============================================================

task.spawn(function()
    while RUNNING do
        local success, data = pcall(getData)

        if success and data then
            updateDisplay(data)

            if data.Slot ~= CurrentSlot then
                CurrentSlot = data.Slot
            end

            if AUTO_BUY and not RESTOCK_BUSY then
                local remaining = data.NextTime - data.Now

                if remaining <= RESTOCK_TRIGGER
                and LastAttempt["Handled:" .. tostring(data.Slot)] == nil then

                    task.spawn(function()
                        restockCycle(data.Slot)
                    end)
                elseif not RESTOCK_BUSY then
                    -- Keep the original automatic buying behavior
                    -- between restocks as well.
                    attemptBuy(data)
                end
            end

        elseif not success then
            Timer.Text = "DATA ERROR"
            Status.Text = "Check Output"
            warn("[Lantern AutoBuy]", data)
        else
            Timer.Text = "WAITING FOR EVENT"
            EventStatus.Text = "EVENT: NOT ACTIVE"
            Status.Text = "Waiting for Lantern event..."
        end

        task.wait(CHECK_INTERVAL)
    end
end)

