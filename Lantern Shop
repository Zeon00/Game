--============================================================
-- ITEM LIST
--============================================================

local function setupItems(kit)
    Rows = {}

    for _, child in ipairs(List:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    local items = {}

    for _, item in ipairs(kit.Shop.List) do
        if item.Stock and PriorityIndex[item.Key] then
            table.insert(items, item)
        end
    end

    table.sort(items, function(a, b)
        return PriorityIndex[a.Key] < PriorityIndex[b.Key]
    end)

    for index, item in ipairs(items) do
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -5, 0, 34)
        row.BackgroundColor3 = Color3.fromRGB(48, 46, 55)
        row.LayoutOrder = index
        row.Parent = List
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 5)

        local name = label(
            row, "Name", item.Key,
            UDim2.new(0.52, 0, 1, 0),
            UDim2.fromOffset(8, 0),
            Color3.fromRGB(235, 235, 235), 11
        )
        name.Font = Enum.Font.GothamBold

        local stock = label(
            row, "Stock", "WAITING",
            UDim2.new(0.48, -8, 1, 0),
            UDim2.new(0.52, 0, 0, 0),
            Color3.fromRGB(180, 180, 180), 10
        )
        stock.TextXAlignment = Enum.TextXAlignment.Right

        Rows[item.Key] = {
            Frame = row,
            Stock = stock,
            Item = item,
        }
    end

    return items
end

--============================================================
-- CHARACTER / POSITION
--============================================================

local function getRoot()
    local character = Player.Character
    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

local function teleportTo(position)
    local character = Player.Character
    local root = getRoot()

    if not character or not root then
        return false
    end

    character:PivotTo(CFrame.new(position))
    task.wait(TELEPORT_DELAY)

    return getRoot() ~= nil
end

--============================================================
-- TIMER
--============================================================

local function formatTime(seconds)
    seconds = math.max(0, math.floor(seconds))

    local minutes = math.floor(seconds / 60)
    local secs = seconds % 60

    return string.format("%02d:%02d", minutes, secs)
end

--============================================================
-- EVENT DATA
--============================================================

local CurrentKit
local CurrentItems = {}
local LastHandledSlot = nil

local function getData()
    local kit = EventKit.running()

    if not kit then
        return nil
    end

    if CurrentKit ~= kit then
        CurrentKit = kit
        CurrentItems = setupItems(kit)
        LastHandledSlot = nil
    end

    local now = workspace:GetServerTimeNow()
    local state = EventKit.state(Player)
    local buys = state.Buys

    local slot, startTime, nextTime = ShopAPI.slot(kit, now)
    local stock = ShopAPI.stock(kit, slot)

    return {
        Kit = kit,
        Now = now,
        State = state,
        Buys = buys,
        Slot = slot,
        StartTime = startTime,
        NextTime = nextTime,
        Stock = stock,
    }
end

local function updateDisplay(data)
    if not data then
        Timer.Text = "EVENT NOT ACTIVE"
        EventStatus.Text = "EVENT: NOT RUNNING"
        return
    end

    Timer.Text = "NEXT RESTOCK: " ..
        formatTime(data.NextTime - data.Now)

    EventStatus.Text = "EVENT ACTIVE | SLOT " ..
        tostring(data.Slot)

    local tokens = tonumber(Player:GetAttribute("EvTokens"))
        or tonumber(data.State.Tokens)
        or 0

    for _, item in ipairs(CurrentItems) do
        local row = Rows[item.Key]

        if row then
            local left = ShopAPI.left(
                data.Kit,
                data.Buys,
                item.Key,
                data.Now
            )

            local price = tonumber(item.Price) or 0
            row.Stock.Text = tostring(left) ..
                " LEFT | " .. tostring(price) .. " T"

            if left > 0 and tokens >= price then
                row.Stock.TextColor3 = Color3.fromRGB(100, 255, 140)
                row.Frame.BackgroundColor3 = Color3.fromRGB(43, 55, 46)
            elseif left > 0 then
                row.Stock.TextColor3 = Color3.fromRGB(255, 190, 90)
                row.Frame.BackgroundColor3 = Color3.fromRGB(55, 49, 40)
            else
                row.Stock.TextColor3 = Color3.fromRGB(255, 105, 105)
                row.Frame.BackgroundColor3 = Color3.fromRGB(48, 46, 55)
            end
        end
    end
end

--============================================================
-- BUY ALL AVAILABLE
--============================================================

local function buyAll(data)
    local tokens = tonumber(Player:GetAttribute("EvTokens"))
        or tonumber(EventKit.state(Player).Tokens)
        or 0

    for _, item in ipairs(CurrentItems) do
        if not RUNNING then
            break
        end

        local key = item.Key
        local price = tonumber(item.Price) or 0

        local currentState = EventKit.state(Player)
        local left = ShopAPI.left(
            data.Kit,
            currentState.Buys,
            key,
            workspace:GetServerTimeNow()
        )

        local count = math.min(left, 3)

        for purchaseIndex = 1, count do
            if not RUNNING then
                break
            end

            tokens = tonumber(Player:GetAttribute("EvTokens"))
                or tonumber(EventKit.state(Player).Tokens)
                or tokens

            if tokens < price then
                Status.Text = "Not enough tokens: " .. key
                break
            end

            Status.Text = "Buying " .. key ..
                " (" .. purchaseIndex .. "/" .. count .. ")"

            local ok, result = pcall(function()
                return Request:InvokeServer("EventBuy", key)
            end)

            if not ok or result ~= true then
                Status.Text = "Purchase rejected: " .. key
                if not ok then
                    warn("[Lantern AutoBuy]", result)
                end
                break
            end

            task.wait(BUY_DELAY)

            local updated = EventKit.state(Player)
            tokens = tonumber(Player:GetAttribute("EvTokens"))
                or tonumber(updated.Tokens)
                or tokens

            local remaining = ShopAPI.left(
                data.Kit,
                updated.Buys,
                key,
                workspace:GetServerTimeNow()
            )

            if remaining >= left then
                Status.Text = "Waiting for server update: " .. key
                task.wait(0.5)

                updated = EventKit.state(Player)
                remaining = ShopAPI.left(
                    data.Kit,
                    updated.Buys,
                    key,
                    workspace:GetServerTimeNow()
                )

                if remaining >= left then
                    Status.Text = "Stock not updated: " .. key
                    break
                end
            end

            left = remaining
        end
    end
end

--============================================================
-- RESTOCK TELEPORT CYCLE
--============================================================

local function restockCycle(oldSlot)
    if BUSY or not AUTO_BUY then
        return
    end

    BUSY = true

    local root = getRoot()
    if not root then
        Status.Text = "Character unavailable"
        BUSY = false
        return
    end

    local originalCFrame = root.CFrame

    Status.Text = "Teleporting to Shop Zone..."

    local moved = teleportTo(SHOP_POSITION)

    if not moved then
        Status.Text = "Teleport failed"
        BUSY = false
        return
    end

    Status.Text = "Waiting for new stock..."

    local newData = nil
    local deadline = os.clock() + 8

    repeat
        task.wait(0.1)

        local ok, data = pcall(getData)
        if ok and data and data.Slot ~= oldSlot then
            newData = data
            break
        end
    until os.clock() >= deadline or not RUNNING

    if newData and RUNNING then
        updateDisplay(newData)
        Status.Text = "New stock detected! Buying..."

        local ok, err = pcall(function()
            buyAll(newData)
        end)

        if not ok then
            warn("[Lantern AutoBuy]", err)
            Status.Text = "Buy error"
        end

        LastHandledSlot = newData.Slot
    else
        Status.Text = "Restock not detected"
    end

    -- Return to the saved position after the purchase cycle.
    if RUNNING and Player.Character then
        Status.Text = "Returning to original position..."
        Player.Character:PivotTo(originalCFrame)
        task.wait(0.25)
    end

    Status.Text = "Waiting for next restock..."
    BUSY = false
end

