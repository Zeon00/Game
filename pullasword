GUI:CreateToggle({
    parent = main,
    text = "Auto Race",
    default = false,

    callback = function(state)
        _G.AutoTouchRing = state

        if not state then
            return
        end

        task.spawn(function()
            local RS = game:GetService("ReplicatedStorage")
            local Players = game:GetService("Players")
            local Player = Players.LocalPlayer

            local AngelsRace = RS
                :WaitForChild("Remotes")
                :WaitForChild("Events")
                :WaitForChild("AngelsRace")

            local Rings = workspace
                :WaitForChild("SystemObjects")
                :WaitForChild("CelestialEvent2026")
                :WaitForChild("FlyLession")
                :WaitForChild("Rings")

            local Won = false
            local Connection

            -- Tunggu hasil race dari server
            Connection = AngelsRace.OnClientEvent:Connect(function(event)
                if event == "PlayerWon" then
                    Won = true
                    print("You Won Race!")
                end
            end)

            while _G.AutoTouchRing do

                Won = false

                -- Start Race
                AngelsRace:FireServer("StartRace", "3")

                -- Tunggu 3 detik
                task.wait(3)

                if not _G.AutoTouchRing then
                    break
                end

                -- Race Started
                AngelsRace:FireServer("RaceStarted")

                task.wait(1)

                -- Touch Ring 1 sampai 8
                for i = 1, 8 do

                    if not _G.AutoTouchRing then
                        break
                    end

                    local Ring = Rings:FindFirstChild(tostring(i))

                    if Ring then
                        local Character = Player.Character
                        local HRP = Character
                            and Character:FindFirstChild("HumanoidRootPart")

                        if HRP then
                            HRP.CFrame =
                                Ring.CFrame + Vector3.new(0, 1, 0)
                        end

                        task.wait(2.5)
                    else
                        warn("Ring " .. i .. " tidak ditemukan")
                        break
                    end
                end

                if not _G.AutoTouchRing then
                    break
                end

                -- TUNGGU SAMPAI BENAR-BENAR PLAYER WON
                repeat
                    task.wait(0.5)
                until Won or not _G.AutoTouchRing

                if not _G.AutoTouchRing then
                    break
                end

                -- Setelah PlayerWon baru ulang StartRace
                task.wait(1)
            end

            if Connection then
                Connection:Disconnect()
                Connection = nil
            end
        end)
    end
})
