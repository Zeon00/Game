GUI:CreateToggle({
    parent = main,
    text = "Auto Quiz",
    default = false,

    callback = function(state)
        _G.AutoQuiz = state

        if not state then
            return
        end

        task.spawn(function()
            while _G.AutoQuiz do

                local Quiz = game:GetService("ReplicatedStorage")
                    :WaitForChild("Remotes")
                    :WaitForChild("Functions")
                    :WaitForChild("Quiz")

                -- Start Quiz
                local result = Quiz
                    :WaitForChild("OnStartQuiz")
                    :InvokeServer("Easy")

                if not _G.AutoQuiz then
                    break
                end

                -- Server memberikan pertanyaan pertama
                if result and result.ok then

                    local question = result

                    while _G.AutoQuiz and question do

                        -- Jumlah jawaban bisa 1-4
                        local answerCount = #question.answers

                        if answerCount > 0 then

                            -- Random 1 sampai jumlah jawaban
                            local randomAnswer = math.random(1, answerCount)

                            local response = Quiz
                                :WaitForChild("AnswerQuestion")
                                :InvokeServer({
                                    questionId = question.questionId,
                                    answerIndex = randomAnswer
                                })

                            if response and response.ok then

                                -- Masih ada pertanyaan berikutnya
                                if not response.complete then
                                    question = response
                                else
                                    -- Quiz selesai
                                    question = nil
                                end

                            else
                                -- Session/error
                                question = nil
                            end

                        else
                            question = nil
                        end

                        task.wait(0.1)
                    end
                end

                -- Jeda sebelum mulai quiz berikutnya
                if _G.AutoQuiz then
                    task.wait(1)
                end
            end
        end)
    end
})
