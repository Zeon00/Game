_G.AutoFishing = false
_G.AutoFishingVersion = 0

GUI:CreateToggle({
    parent = main,
    text = "Auto Fishing",
    default = false,

    callback = function(state)
        _G.AutoFishing = state
        _G.AutoFishingVersion = _G.AutoFishingVersion + 1

        local version = _G.AutoFishingVersion

        if not state then
            return
        end

        task.spawn(function()
            local ReplicatedStorage = game:GetService("ReplicatedStorage")
            local Players = game:GetService("Players")

            local Player = Players.LocalPlayer

            local Fishing = ReplicatedStorage
                :WaitForChild("Remotes")
                :WaitForChild("Fishing")

            local function active()
                return _G.AutoFishing
                    and _G.AutoFishingVersion == version
            end

            while active() do

                -- =========================
                -- CAST ROD
                -- =========================
                local success = pcall(function()
                    return Fishing
                        :WaitForChild("CastRod")
                        :InvokeServer()
                end)

                if not active() then
                    break
                end

                if not success then
                    task.wait(1)
                    continue
                end

                -- =========================
                -- TUNGGU IKAN MENGGIGIT
                -- =========================
                local timeout = 0

                while active()
                    and not Player:GetAttribute("hasBite") do

                    task.wait(0.1)

                    timeout = timeout + 0.1

                    if timeout >= 30 then
                        break
                    end
                end

                if not active() then
                    break
                end

                -- =========================
                -- IKAN MENGGIGIT
                -- =========================
                if Player:GetAttribute("hasBite") then

                    Fishing
                        :WaitForChild("PlayerReaction")
                        :FireServer()

                    task.wait(0.1)

                    -- =========================
                    -- UPDATE BALL
                    -- =========================
                    local rod = Player.Character
                        and Player.Character:FindFirstChild("FishingRod")

                    local ball = rod
                        and rod:FindFirstChild("Ball")

                    local body = rod
                        and rod:FindFirstChild("Body")

                    if ball and body then

                        local startPosition = ball.Position

                        -- Jalankan update selama minigame
                        local miniGameTime = 0

                        while active()
                            and Player:GetAttribute("IsInMiniGame")
                            and miniGameTime < 15 do

                            local character = Player.Character

                            if not character
                                or not character.PrimaryPart then
                                break
                            end

                            -- Posisi ball mengikuti karakter
                            local playerPos =
                                character:GetPivot().Position

                            local position = Vector3.new(
                                playerPos.X,
                                startPosition.Y,
                                playerPos.Z
                            )

                            local distance =
                                (position - body.Line.WorldPosition).Magnitude
                                + 0.5

                            Fishing
                                :WaitForChild("UpdateBall")
                                :FireServer(
                                    distance,
                                    position,
                                    true
                                )

                            miniGameTime =
                                miniGameTime + 0.05

                            task.wait(0.05)
                        end
                    end

                    -- =========================
                    -- PREPARE REEL
                    -- =========================
                    if active() then

                        Fishing
                            :WaitForChild("PrepareFishForReeling")
                            :FireServer()

                        task.wait(0.1)

                        -- =========================
                        -- REEL IN
                        -- =========================
                        Fishing
                            :WaitForChild("ReelIn")
                            :FireServer(2.5)
                    end
                end

                -- Tunggu sebelum cast berikutnya
                if active() then
                    task.wait(1)
                end
