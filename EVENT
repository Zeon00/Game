local function setToggle(name, value)
    ToggleStates[name] = value

    local button = ToggleButtons[name]
    if button then
        button.Text = name .. " : " .. (value and "ON" or "OFF")
        button.BackgroundColor3 = value
            and Color3.fromRGB(35, 145, 85)
            or Color3.fromRGB(125, 55, 55)
    end
end

--============================================================
-- MOB HELPERS
--============================================================

local function getMobRoot(mob)
    if not mob or not mob:IsA("Model") then
        return nil
    end

    return mob:FindFirstChild("HumanoidRootPart")
        or mob.PrimaryPart
        or mob:FindFirstChild("RootPart")
end

local function getHealth(mob)
    if not mob then return nil end

    local hum = mob:FindFirstChildOfClass("Humanoid")
    if hum then return hum.Health end

    local health = mob:FindFirstChild("Health")
    if health and health:IsA("NumberValue") then
        return health.Value
    end

    local attr = mob:GetAttribute("Health")
    if typeof(attr) == "number" then
        return attr
    end

    return nil
end

local function isDead(mob)
    if not mob or not mob.Parent then return true end
    if mob:GetAttribute("Dead") == true then return true end

    local dead = mob:FindFirstChild("Dead")
    if dead and dead:IsA("BoolValue") and dead.Value then
        return true
    end

    local hp = getHealth(mob)
    return hp ~= nil and hp <= 0
end

local function validOwner(mob)
    local owner = mob:GetAttribute("Owner")

    if owner == nil then
        local obj = mob:FindFirstChild("Owner")
        if obj and obj:IsA("ValueBase") then
            owner = obj.Value
        end
    end

    if owner == nil or owner == "" or owner == 0 then
        return true
    end

    return owner == Player.UserId or owner == Player.Name
end

local function getAllMobs()
    local folder = Workspace:FindFirstChild("Enemies")
    local result = {}

    if not folder then return result end

    for _, mob in ipairs(folder:GetChildren()) do
        if mob:IsA("Model")
            and not isDead(mob)
            and validOwner(mob)
            and getMobRoot(mob) then

            table.insert(result, mob)
        end
    end

    return result
end

local function getEnemyCount()
    return #getAllMobs()
end

local function getNearestMob()
    updateCharacter()
    if not Root then return nil end

    local bestMob
    local bestDistance = math.huge

    for _, mob in ipairs(getAllMobs()) do
        local mobRoot = getMobRoot(mob)

        if mobRoot then
            local distance = (Root.Position - mobRoot.Position).Magnitude

            if distance < bestDistance then
                bestDistance = distance
                bestMob = mob
            end
        end
    end

    return bestMob
end

--============================================================
-- OBJECT HELPERS
--============================================================

local function getObjectCFrame(object)
    if not object then return nil end

    if object:IsA("BasePart") then
        return object.CFrame
    end

    if object:IsA("Model") then
        return object:GetPivot()
    end

    local part = object:FindFirstChildWhichIsA("BasePart", true)
    return part and part.CFrame or nil
end

local function getDungeonObject(path)
    local current = Workspace:FindFirstChild("Dungeons")
    if not current then return nil end

    current = current:FindFirstChild(DUNGEON)
    if not current then return nil end

    for _, name in ipairs(path) do
        current = current:FindFirstChild(name)
        if not current then return nil end
    end

    return current
end

--============================================================
-- PATHFINDING
--============================================================

local function moveToPosition(position, isActive, label)
    if not isActive() then return false end

    updateCharacter()
    if not Root or not Humanoid then return false end

    local oldSpeed = Humanoid.WalkSpeed
    Humanoid.WalkSpeed = 60

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = 15
    })

    local computed = false

    for attempt = 1, 10 do
        if not isActive() then
            Humanoid.WalkSpeed = oldSpeed
            return false
        end

        updateCharacter()
        if not Root then break end

        local ok = pcall(function()
            path:ComputeAsync(Root.Position, position)
        end)

        if ok and path.Status == Enum.PathStatus.Success then
            computed = true
            break
        end

        status(label .. " | Path retry " .. attempt)
        task.wait(0.2)
    end

    if not computed then
        updateCharacter()
        if Humanoid then Humanoid.WalkSpeed = oldSpeed end
        return false
    end

    for _, waypoint in ipairs(path:GetWaypoints()) do
        if not isActive() then
            updateCharacter()
            if Humanoid then Humanoid.WalkSpeed = oldSpeed end
            return false
        end

        updateCharacter()
        if not Root or not Humanoid then break end

        if waypoint.Action == Enum.PathWaypointAction.Jump then
            Humanoid.Jump = true
        end

        Humanoid:MoveTo(waypoint.Position)

        local deadline = os.clock() + 3
        local reached = false

        while isActive() and os.clock() < deadline do
            updateCharacter()
            if not Root then break end

            if (Root.Position - waypoint.Position).Magnitude <= 3 then
                reached = true
                break
            end

            task.wait(0.02)
        end

        if not reached then
            updateCharacter()
            if Humanoid then
                Humanoid.WalkSpeed = oldSpeed
            end
            return false
        end
    end

    updateCharacter()

    local arrived = Root
        and (Root.Position - position).Magnitude <= 7

    if Humanoid then
        Humanoid.WalkSpeed = oldSpeed
    end

    return arrived
end

local function moveToObject(object, isActive, label)
    local cf = getObjectCFrame(object)
    if not cf then return false end

    return moveToPosition(cf.Position, isActive, label)
end

--============================================================
-- MONSTER BEACON
-- HANYA DIPROSES KALAU OBJEKNYA SUDAH MUNCUL
--============================================================

local function findMonsterBeacon()
    local dungeon = getDungeonObject({})

    if not dungeon then return nil end

    for _, object in ipairs(dungeon:GetDescendants()) do
        if string.lower(object.Name):find("monsterbeacon", 1, true)
            and getObjectCFrame(object) then
            return object
        end
    end

    return nil
end

local lastBeacon = nil
local lastBeaconPosition = nil
local lastBeaconMoveTime = 0

local function handleMonsterBeacon(id)
    if not alive(id) then return false end

    -- Jangan mencari atau menunggu beacon sebelum beacon benar-benar ada.
    local beacon = findMonsterBeacon()
    if not beacon then return false end

    local cf = getObjectCFrame(beacon)
    if not cf then return false end

    updateCharacter()
    if not Root then return false end

    local position = cf.Position

    local changed = beacon ~= lastBeacon

    if lastBeaconPosition
        and (position - lastBeaconPosition).Magnitude > BEACON_CHANGE_DISTANCE then
        changed = true
    end

    if changed then
        lastBeacon = beacon
        lastBeaconPosition = position
    end

    local distance = (Root.Position - position).Magnitude

    if distance <= BEACON_DISTANCE then
        return false
    end

    if os.clock() - lastBeaconMoveTime < BEACON_MOVE_INTERVAL then
        return true
    end

    lastBeaconMoveTime = os.clock()

    status("Mob tertinggal | MonsterBeacon ditemukan | Pathfinding...")

    moveToObject(
        beacon,
        function()
            return alive(id) and beacon.Parent ~= nil
        end,
        "MonsterBeacon"
    )

    local newCF = getObjectCFrame(beacon)

    if newCF then
        lastBeacon = beacon
        lastBeaconPosition = newCF.Position
    end

    return true
end

--============================================================
-- DUNGEON PROGRESS
--============================================================

local function getProgressText()
    local playerGui = Player:FindFirstChild("PlayerGui")
    local gameUI = playerGui and playerGui:FindFirstChild("GameUI")
    local bar = gameUI and gameUI:FindFirstChild("DungeonBar")
    local progress = bar and bar:FindFirstChild("Progress")
    local textFolder = progress and progress:FindFirstChild("Text")

    if not textFolder then
        return "", ""
    end

    local valueObject = textFolder:FindFirstChild("Value")
    local captionObject = textFolder:FindFirstChild("Caption")

    local value = valueObject and valueObject.Text or ""
    local caption = captionObject and captionObject.Text or ""

    return string.upper(value), string.upper(caption)
end

local function isBossOpen()
    local value, caption = getProgressText()

    value = value:match("^%s*(.-)%s*$")
    caption = caption:match("^%s*(.-)%s*$")

    return value == "BOSS" and caption == "OPEN!"
end

--============================================================
-- ROAM OUTER POINTERS
--============================================================

local function getRoamMarkers()
    local markers = getDungeonObject({"Markers"})
    local result = {}

    if not markers then return result end

    for _, object in ipairs(markers:GetChildren()) do
        local number = object.Name:match("^Roam_Outer_(%d+)$")

        if number and getObjectCFrame(object) then
            table.insert(result, {
                object = object,
                index = tonumber(number)
            })
        end
    end

    table.sort(result, function(a, b)
        return a.index < b.index
    end)

    return result
end

--============================================================
-- FEST CLEAR LOOP
-- MOB DULU -> BEACON JIKA SUDAH MUNCUL
--============================================================

local function clearDungeon(id)
    local markerIndex = 1
    local emptyStart = nil
    local retryAt = 0

    while alive(id) do
        if isBossOpen() then
            status("OPEN! | BOSS")
            return true
        end

        local mobs = getAllMobs()

        if #mobs > 0 then
            emptyStart = nil

            -- Mob masih ada: tetap clear mob.
            -- Beacon hanya ditangani jika memang sudah muncul.
            local beaconHandled = handleMonsterBeacon(id)

            if not alive(id) then return false end

            if not beaconHandled then
                local mob = getNearestMob()
                local mobRoot = mob and getMobRoot(mob)

                if mobRoot then
                    updateCharacter()

                    local distance = Root
                        and (Root.Position - mobRoot.Position).Magnitude
                        or math.huge

                    if distance > 10 then
                        status("Clear mob | Menuju " .. mob.Name)

                        moveToPosition(
                            mobRoot.Position,
                            function()
                                return alive(id)
                                    and mob.Parent ~= nil
                                    and not isDead(mob)
                            end,
                            "Mengejar mob"
                        )
                    else
                        status("Mob dekat | Menunggu clear...")
                        task.wait(0.2)
                    end
                end
            end

            task.wait(0.1)
            continue
        end

        -- Tidak ada mob: konfirmasi kosong 2 detik.
        emptyStart = emptyStart or os.clock()

        if os.clock() - emptyStart < 2 then
            status("Enemies kosong | Konfirmasi...")
            task.wait(0.15)
            continue
        end

        if isBossOpen() then
            return true
        end

        local markers = getRoamMarkers()

        if #markers == 0 then
            status("Menunggu pointer Roam_Outer...")
            task.wait(0.5)
            continue
        end

        if markerIndex > #markers then
            markerIndex = 1
        end

        local entry = markers[markerIndex]
        local marker = entry.object
        local cf = getObjectCFrame(marker)

        if not cf then
            markerIndex += 1
            continue
        end

        updateCharacter()

        local distance = Root
            and (Root.Position - cf.Position).Magnitude
            or math.huge

        if distance <= 8 then
            markerIndex += 1
            emptyStart = nil
            task.wait(0.5)
            continue
        end

        if os.clock() >= retryAt then
            status("Pointer Roam_Outer_" .. entry.index)

            local moved = moveToObject(
                marker,
                function()
                    return alive(id)
                        and getEnemyCount() == 0
                        and not isBossOpen()
                end,
                "Roam Outer"
            )

            if moved then
                markerIndex += 1
                emptyStart = nil
            else
                retryAt = os.clock() + 0.5
            end
        end

        task.wait(0.15)
    end

    return false
end

