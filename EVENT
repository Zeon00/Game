-- AUTO EVENT RESTOCK
--============================================================

local function getCurrentEvent()
    if not EventKit then return nil end

    local ok, event = pcall(function()
        return EventKit.latest()
    end)

    if ok then
        return event
    end

    return nil
end

local function getEventSlot()
    if not EventKit or not EventKit.Shop then
        return nil
    end

    local event = getCurrentEvent()
    if not event then return nil end

    local ok, slot = pcall(function()
        return EventKit.Shop.slot(
            event,
            Workspace:GetServerTimeNow()
        )
    end)

    if ok then
        return slot
    end

    return nil
end

local function getEventItems()
    local event = getCurrentEvent()
    if not event then return nil end

    local shop = event.Shop
    if not shop then return nil end

    local items = shop.List
    if type(items) ~= "table" then return nil end

    return items
end

local function teleportToEventShop(id)
    updateCharacter()

    if not Root then
        status("Menunggu karakter...")
        return false
    end

    status("Teleport ke Event Shop...")

    local success = pcall(function()
        Root.CFrame = CFrame.new(EVENT_SHOP_POS)
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end)

    if not success then
        return false
    end

    task.wait(0.35)

    if not eventAlive(id) then
        return false
    end

    updateCharacter()

    if not Root then
        return false
    end

    local distance = (Root.Position - EVENT_SHOP_POS).Magnitude

    if distance > 8 then
        status("Teleport ulang Event Shop...")

        pcall(function()
            Root.CFrame = CFrame.new(EVENT_SHOP_POS)
            Root.AssemblyLinearVelocity = Vector3.zero
            Root.AssemblyAngularVelocity = Vector3.zero
        end)

        task.wait(0.35)
    end

    return eventAlive(id)
end

local function buyAllEventItems(id)
    if not eventAlive(id) then return end

    local items = getEventItems()

    if not items then
        status("Daftar Event Shop belum tersedia")
        return
    end

    local attempted = 0
    local accepted = 0
    local rejected = 0

    status("Mengirim request pembelian...")

    for _, item in ipairs(items) do
        if not eventAlive(id) then
            break
        end

        if item.Once == nil and item.Key ~= nil then
            attempted += 1

            status("Request beli: " .. tostring(item.Key))

            local ok, result = pcall(function()
                return RequestRemote:InvokeServer(
                    "EventBuy",
                    item.Key
                )
            end)

            if ok and result == true then
                accepted += 1
            else
                rejected += 1
            end
        end
    end

    if eventAlive(id) then
        status(
            "Event selesai | Request: " .. attempted ..
            " | Diterima: " .. accepted ..
            " | Ditolak: " .. rejected
        )
    end
end

local function startEventRestock()
    if AutoEventRestock then return end

    AutoEventRestock = true
    EventRunId += 1

    local id = EventRunId

    setToggle("AUTO EVENT RESTOCK", true)
    status("Memulai monitor Event Restock...")

    task.spawn(function()
        local previousSlot

        while eventAlive(id) and previousSlot == nil do
            previousSlot = getEventSlot()

            if previousSlot == nil then
                status("Menunggu data Event Shop...")
                task.wait(1)
            end
        end

        if not eventAlive(id) then return end

        status("Memantau restock | Slot: " .. tostring(previousSlot))

        while eventAlive(id) do
            task.wait(EVENT_CHECK_INTERVAL)

            if not eventAlive(id) then
                break
            end

            local currentSlot = getEventSlot()

            if currentSlot ~= nil and currentSlot ~= previousSlot then
                previousSlot = currentSlot

                status("RESTOCK TERDETEKSI!")

                if teleportToEventShop(id) then
                    buyAllEventItems(id)
                end
            end
        end

        if EventRunId == id then
            AutoEventRestock = false
            setToggle("AUTO EVENT RESTOCK", false)
            status("Monitor Event Restock berhenti.")
        end
    end)
end

local function stopEventRestock()
    AutoEventRestock = false
    EventRunId += 1

    setToggle("AUTO EVENT RESTOCK", false)
    status("AUTO EVENT RESTOCK dihentikan.")
end

--============================================================
-- MOB HELPERS
--============================================================

local function getMobRoot(mob)
    if not mob or not mob:IsA("Model") then return nil end

    return mob:FindFirstChild("HumanoidRootPart")
        or mob.PrimaryPart
        or mob:FindFirstChild("RootPart")
end

local function getHealth(mob)
    if not mob then return nil end

    local hum = mob:FindFirstChildOfClass("Humanoid")
    if hum then return hum.Health end

    local health = mob:FindFirstChild("Health")
    if health and health:IsA("NumberValue") then
        return health.Value
    end

    local attr = mob:GetAttribute("Health")
    if typeof(attr) == "number" then
        return attr
    end

    return nil
end

local function isDead(mob)
    if not mob or not mob.Parent then return true end
    if mob:GetAttribute("Dead") == true then return true end

    local dead = mob:FindFirstChild("Dead")
    if dead and dead:IsA("BoolValue") and dead.Value then
        return true
    end

    local hp = getHealth(mob)
    return hp ~= nil and hp <= 0
end

local function validOwner(mob)
    local owner = mob:GetAttribute("Owner")

    if owner == nil then
        local obj = mob:FindFirstChild("Owner")
        if obj and obj:IsA("ValueBase") then
            owner = obj.Value
        end
    end

    if owner == nil or owner == "" or owner == 0 then
        return true
    end

    return owner == Player.UserId or owner == Player.Name
end

local function getAllMobs()
    local folder = Workspace:FindFirstChild("Enemies")
    local result = {}

    if not folder then return result end

    for _, mob in ipairs(folder:GetChildren()) do
        if mob:IsA("Model")
            and not isDead(mob)
            and validOwner(mob)
            and getMobRoot(mob) then
            table.insert(result, mob)
        end
    end

    return result
end

local function getNearestMob()
    updateCharacter()
    if not Root then return nil end

    local bestMob
    local bestDistance = math.huge

    for _, mob in ipairs(getAllMobs()) do
        local mobRoot = getMobRoot(mob)

        if mobRoot then
            local distance = (Root.Position - mobRoot.Position).Magnitude

            if distance < bestDistance then
                bestDistance = distance
                bestMob = mob
            end
        end
    end

    return bestMob
end

