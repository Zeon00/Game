local function startCombat()
    if AutoCombat then return end
    AutoCombat = true

    task.spawn(function()
        while Running and AutoCombat do
            SwingIndex = (SwingIndex % 3) + 1

            pcall(function()
                SwingRemote:FireServer(SwingIndex)
            end)

            local mobs = getAllMobs()

            if #mobs > 0 then
                pcall(function()
                    HitRemote:FireServer(SwingIndex, 1, mobs)
                end)
            end

            task.wait(SWING_DELAY)
        end
    end)
end

