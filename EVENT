local function getObjectPosition(object)
    if not object then return nil end

    if object:IsA("BasePart") then
        return object.Position
    end

    if object:IsA("Model") then
        return object:GetPivot().Position
    end

    local part = object:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function getDungeonObject(path)
    local current = Workspace:FindFirstChild("Dungeons")
    if not current then return nil end

    current = current:FindFirstChild(DUNGEON)
    if not current then return nil end

    for _, name in ipairs(path) do
        current = current:FindFirstChild(name)
        if not current then return nil end
    end

    return current
end

--============================================================
-- DIRECT MOVETO
--============================================================

local function moveToPosition(position, isActive, label, stopDistance)
    stopDistance = stopDistance or 5

    updateCharacter()
    if not Root or not Humanoid then return false end

    local oldSpeed = Humanoid.WalkSpeed
    Humanoid.WalkSpeed = math.max(oldSpeed, 16)

    local arrived = false
    local lastMove = 0

    while isActive() do
        updateCharacter()

        if not Root or not Humanoid or Humanoid.Health <= 0 then
            break
        end

        local distance = (Root.Position - position).Magnitude

        if distance <= stopDistance then
            arrived = true
            break
        end

        if os.clock() - lastMove >= 1 then
            Humanoid:MoveTo(position)
            lastMove = os.clock()
        end

        status(label .. " | " .. math.floor(distance) .. " studs")
        task.wait(0.12)
    end

    updateCharacter()

    if Humanoid then
        Humanoid:MoveTo(Root and Root.Position or position)
        Humanoid.WalkSpeed = oldSpeed
    end

    return arrived
end

--============================================================
-- FLOOR GLOW
--============================================================

local function moveToFloorGlow(id)
    updateCharacter()
    if not Root or not Humanoid then return false end

    local oldSpeed = Humanoid.WalkSpeed
    Humanoid.WalkSpeed = math.max(oldSpeed, 16)

    local arrived = false
    local lastMove = 0
    local blockPassed = false

    while alive(id) do
        updateCharacter()

        if not Root or not Humanoid or Humanoid.Health <= 0 then
            task.wait(0.2)
            continue
        end

        if not blockPassed then
            local blockDistance = (Root.Position - BLOCK_CHECK).Magnitude

            if blockDistance > BLOCK_RADIUS then
                if os.clock() - lastMove >= 0.5 then
                    Humanoid:MoveTo(BLOCK_CHECK)
                    lastMove = os.clock()
                end

                status("Menuju penghalang | " .. math.floor(blockDistance) .. " studs")
                task.wait(0.1)
                continue
            end

            status("Penghalang terdeteksi | Teleport...")

            Humanoid:MoveTo(Root.Position)

            local teleportSuccess = false

            while alive(id) and not teleportSuccess do
                updateCharacter()

                if not Root or not Humanoid then
                    task.wait(0.2)
                    continue
                end

                pcall(function()
                    Root.CFrame = CFrame.new(BLOCK_TP)
                    Root.AssemblyLinearVelocity = Vector3.zero
                    Root.AssemblyAngularVelocity = Vector3.zero
                end)

                task.wait(0.2)

                updateCharacter()

                if Root then
                    local verifyDistance = (Root.Position - BLOCK_TP).Magnitude

                    if verifyDistance <= BLOCK_TP_VERIFY_RADIUS then
                        teleportSuccess = true
                        blockPassed = true
                        lastMove = 0
                        status("Teleport berhasil | Lanjut lari")
                    else
                        status("Teleport ulang | " .. math.floor(verifyDistance) .. " studs")
                    end
                end

                task.wait(0.15)
            end

            if not alive(id) then
                break
            end
        end

        local floorDistance = (Root.Position - FLOOR_GLOW_POS).Magnitude

        if floorDistance <= FLOOR_GLOW_RADIUS then
            arrived = true
            break
        end

        if os.clock() - lastMove >= 0.5 then
            Humanoid:MoveTo(FLOOR_GLOW_POS)
            lastMove = os.clock()
        end

        status("Menuju FloorGlow | " .. math.floor(floorDistance) .. " studs")
        task.wait(0.12)
    end

    updateCharacter()

    if Humanoid then
        Humanoid:MoveTo(Root and Root.Position or FLOOR_GLOW_POS)
        Humanoid.WalkSpeed = oldSpeed
    end

    return arrived
end

local function clearDungeon(id, floorGlow)
    if not floorGlow then
        status("FloorGlow belum ditemukan!")
        return false
    end

    status("Menuju checkpoint dan FloorGlow...")

    local reached = moveToFloorGlow(id)

    if reached then
        status("FloorGlow tercapai!")
    end

    return reached
end

