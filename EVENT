    ToggleButtons[name] = button

    button.MouseButton1Click:Connect(function()
        local value = not ToggleStates[name]

        if name == "AUTO FEST" then
            if value then
                startFest()
            else
                stopFest()
            end

        elseif name == "SWING + HIT" then
            if value then
                startCombat()
            else
                stopCombat()
            end

            setToggle(name, value)

        elseif name == "AUTO SKILL" then
            if value then
                startSkill()
            else
                stopSkill()
            end

            setToggle(name, value)

        elseif name == "AUTO DODGE" then
            AutoDodge = value
            setToggle(name, value)

        elseif name == "AUTO EVENT RESTOCK" then
            if value then
                startEventRestock()
            else
                stopEventRestock()
            end
        end
    end)
end

for index, name in ipairs(names) do
