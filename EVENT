--============================================================
-- AUTO SKILL LOOP
--============================================================

local function startSkill()
    if AutoSkill then return end
    AutoSkill = true

    task.spawn(function()
        while Running and AutoSkill do
            local mob = getNearestMob()
            local mobRoot = mob and getMobRoot(mob)

            if mobRoot and not isDead(mob) then
                SkillIndex = (SkillIndex % #SKILLS) + 1
                local key = SKILLS[SkillIndex]

                pcall(function()
                    RequestRemote:InvokeServer("UseSkill", key, {
                        point = mobRoot.Position
                    })
                end)
            end

            task.wait(SKILL_DELAY)
        end
    end)
end

local function stopSkill()
    AutoSkill = false
end

--============================================================
-- AUTO DODGE | RING + WEDGE/FAN
--============================================================

local DODGE = {
    SCAN_INTERVAL = 0.03,
    COOLDOWN = 0.15,
    TRIGGER_MARGIN = 14,
    SAFE_MARGIN = 6,
    SEARCH_DISTANCES = {16, 22, 28, 36, 45},
    ANGLE_STEP = 15,
    MAX_RISE = 5,
    MAX_DROP = 7
}

local lastDodge = 0

local function horizontalDistance(a, b)
    local x = a.X - b.X
    local z = a.Z - b.Z
    return math.sqrt(x*x + z*z)
end

local function getDangerObjects()
    local rings = {}
    local wedges = {}

    for _, folder in ipairs(Workspace:GetDescendants()) do
        if folder.Name == "ClientFX" and folder:IsA("Folder") then
            for _, obj in ipairs(folder:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Transparency < 1 then
                    local name = string.lower(obj.Name)

                    if name == "ring" then
                        table.insert(rings, obj)
                    elseif name == "wedge"
                        or name:find("fan")
                        or name:find("sector") then
                        table.insert(wedges, obj)
                    end
                end
            end
        end
    end

    return rings, wedges
end

local function insideRing(position, ring, margin)
    local radius = math.max(ring.Size.X, ring.Size.Z) / 2
    return horizontalDistance(position, ring.Position) <= radius + margin
end

local function insideWedge(position, wedge, margin)
    local localPos = wedge.CFrame:PointToObjectSpace(position)
    local radius = math.max(wedge.Size.X, wedge.Size.Z) / 2 + margin

    if math.sqrt(localPos.X^2 + localPos.Z^2) > radius then
        return false
    end

    local angle = wedge:GetAttribute("SectorAngle")
        or wedge:GetAttribute("FanAngle")
        or wedge:GetAttribute("AngleDegrees")

    if typeof(angle) == "number" then
        local playerAngle = math.deg(math.atan2(localPos.X, -localPos.Z))
        return math.abs(playerAngle) <= angle / 2
    end

    local half = wedge.Size / 2

    return math.abs(localPos.X) <= half.X + margin
        and math.abs(localPos.Y) <= half.Y + margin
        and math.abs(localPos.Z) <= half.Z + margin
end

local function isSafePosition(position, rings, wedges)
    for _, ring in ipairs(rings) do
        if ring.Parent and insideRing(position, ring, DODGE.SAFE_MARGIN) then
            return false
        end
    end

    for _, wedge in ipairs(wedges) do
        if wedge.Parent and insideWedge(position, wedge, DODGE.SAFE_MARGIN) then
            return false
        end
    end

    return true
end

local function getGroundPosition(position)
    updateCharacter()
    if not Root or not Character then return nil end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {Character}
    params.IgnoreWater = true

    local result = Workspace:Raycast(
        position + Vector3.new(0, 12, 0),
        Vector3.new(0, -45, 0),
        params
    )

    if not result then return nil end
    if result.Normal.Y < 0.75 then return nil end
    if result.Material == Enum.Material.Water then return nil end

    local difference = result.Position.Y - Root.Position.Y

    if difference > DODGE.MAX_RISE or difference < -DODGE.MAX_DROP then
        return nil
    end

    -- Cek pijakan di sekeliling supaya tidak memilih bibir jurang.
    local radius = 3.5

    for _, offset in ipairs({
        Vector3.new(radius, 0, 0),
        Vector3.new(-radius, 0, 0),
        Vector3.new(0, 0, radius),
        Vector3.new(0, 0, -radius)
    }) do
        local side = Workspace:Raycast(
            result.Position + offset + Vector3.new(0, 5, 0),
            Vector3.new(0, -12, 0),
            params
        )

        if not side or side.Normal.Y < 0.75 then
            return nil
        end

        if math.abs(side.Position.Y - result.Position.Y) > 3.5 then
            return nil
        end
    end

    -- Tolak titik dodge yang jalurnya terhalang tembok.
    local direction = result.Position - Root.Position

    local wall = Workspace:Raycast(
        Root.Position + Vector3.new(0, 2, 0),
        direction,
        params
    )

    if wall then
        return nil
    end

    return result.Position + Vector3.new(
        0,
        Humanoid.HipHeight + Root.Size.Y / 2 + 0.5,
        0
    )
end

local function runDodge()
    updateCharacter()
    if not Root or not Humanoid or Humanoid.Health <= 0 then return end
    if os.clock() - lastDodge < DODGE.COOLDOWN then return end

    local rings, wedges = getDangerObjects()
    if #rings == 0 and #wedges == 0 then return end

    local danger = false

    for _, ring in ipairs(rings) do
        if insideRing(Root.Position, ring, DODGE.TRIGGER_MARGIN) then
            danger = true
            break
        end
    end

    if not danger then
        for _, wedge in ipairs(wedges) do
            if insideWedge(Root.Position, wedge, DODGE.TRIGGER_MARGIN) then
                danger = true
                break
            end
        end
    end

    if not danger then return end

    for _, distance in ipairs(DODGE.SEARCH_DISTANCES) do
        for angle = 0, 359, DODGE.ANGLE_STEP do
            local radians = math.rad(angle)

            local candidate = Root.Position + Vector3.new(
                math.cos(radians) * distance,
                0,
                math.sin(radians) * distance
            )

            local ground = getGroundPosition(candidate)

            if ground and isSafePosition(ground, rings, wedges) then
                local oldCFrame = Root.CFrame

                lastDodge = os.clock()

                pcall(function()
                    Root.CFrame = CFrame.new(ground)
                        * (oldCFrame - oldCFrame.Position)

                    Root.AssemblyLinearVelocity = Vector3.zero
                    Root.AssemblyAngularVelocity = Vector3.zero
                end)

                status("DODGE | Ring " .. #rings .. " | Fan " .. #wedges)
                return
            end
        end
    end
end

task.spawn(function()
    while Running do
        if AutoDodge then
            pcall(runDodge)
        end

        task.wait(DODGE.SCAN_INTERVAL)
    end
end)

--============================================================
-- BOSS
--============================================================

local function getBoss()
    local enemies = Workspace:FindFirstChild("Enemies")
    return enemies and enemies:FindFirstChild(BOSS_NAME)
end

local function bossDead(boss)
    if not boss or not boss.Parent then return true end
    return isDead(boss)
end

local function waitAndFightBoss(id)
    status("Menunggu The Parade Master...")

    local boss

    while alive(id) do
        boss = getBoss()

        if boss and not bossDead(boss) then
            break
        end

        task.wait(0.2)
    end

    if not alive(id) then return false end

    status("The Parade Master ditemukan!")

    while alive(id) and not bossDead(boss) do
        -- Swing + Hit dan Auto Skill tetap mengikuti toggle masing-masing.
        task.wait(0.15)
    end

    status("Boss kalah.")
    return true
end

--============================================================
-- AUTO FEST CYCLE
--============================================================

local function runOneFest(id)
    updateCharacter()
    if not Root then return false end

    -- POS1 teleport satu kali per putaran.
    status("Teleport POS1...")
    Root.CFrame = CFrame.new(POS1 + Vector3.new(0, 3, 0))

    task.wait(0.3)

    -- POS2 harus berjalan.
    status("Walk POS2...")
    if not moveToPosition(POS2, function()
        return alive(id)
    end, "POS2") then
        return false
    end

    task.wait(2)

    if not alive(id) then return false end

    -- Masuk FEST.
    status("EnterDungeon FEST...")

    local ok = pcall(function()
        RequestRemote:InvokeServer(
            "EnterDungeon",
            DUNGEON,
            DUNGEON_COUNT
        )
    end)

    if not ok then
        status("EnterDungeon gagal.")
        return false
    end

    -- Hold click otomatis aktif ketika masuk dungeon.
    setLeftClick(true)

    -- Tunggu BossDoor.
    local bossDoor

    while alive(id) do
        bossDoor = getDungeonObject({"BossDoor"})

        if bossDoor then break end
        task.wait(0.2)
    end

    if not alive(id) then return false end

    -- Clear mob/pointer. Beacon baru dicari jika benar-benar muncul.
    if not clearDungeon(id) then
        return false
    end

    -- FloorGlow.
    local floorGlow = bossDoor:FindFirstChild("FloorGlow")

    while alive(id) and not floorGlow do
        floorGlow = bossDoor:FindFirstChild("FloorGlow")
        task.wait(0.2)
    end

    if not alive(id) then return false end

    status("Pathfinding FloorGlow...")

    if not moveToObject(floorGlow, function()
        return alive(id)
    end, "FloorGlow") then
        return false
    end

    task.wait(2)

    if not waitAndFightBoss(id) then
        return false
    end

    task.wait(2)

    if not alive(id) then return false end

    status("LeaveDungeon...")

    pcall(function()
        RequestRemote:InvokeServer("LeaveDungeon")
    end)

    -- Hold Left Click otomatis OFF setelah keluar.
    setLeftClick(false)

    task.wait(1)
    return true
end

local function startFest()
    if AutoFest then return end

    AutoFest = true
    FestRunId += 1

    local id = FestRunId
    setToggle("AUTO FEST", true)

    task.spawn(function()
        while alive(id) do
            local success = runOneFest(id)

            if not alive(id) then break end

            if success then
                status("FEST selesai | Mengulang...")
                task.wait(0.5)
            else
                status("Run gagal | Retry...")
                task.wait(1)
            end
        end

        if FestRunId == id then
            AutoFest = false
            setToggle("AUTO FEST", false)
            status("AUTO FEST OFF")
        end
    end)
end

local function stopFest()
    AutoFest = false
    FestRunId += 1

    updateCharacter()

    if Humanoid and Root then
        Humanoid:MoveTo(Root.Position)
    end

    setLeftClick(false)
    setToggle("AUTO FEST", false)
    status("AUTO FEST OFF")
end

