-- BOSS
--============================================================

local function getBoss()
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return nil end

    return enemies:FindFirstChild(BOSS_NAME)
end

local function getBossHealth(boss)
    if not boss then return nil end

    local hum = boss:FindFirstChildOfClass("Humanoid")
    if hum then
        return hum.Health
    end

    local health = boss:FindFirstChild("Health")

    if health and (health:IsA("NumberValue") or health:IsA("IntValue")) then
        return health.Value
    end

    local attribute = boss:GetAttribute("Health")

    if typeof(attribute) == "number" then
        return attribute
    end

    return nil
end

local function waitBossDefeated(id)
    local boss

    status("Menunggu The Parade Master...")

    while alive(id) do
        boss = getBoss()

        if boss and boss.Parent then
            break
        end

        task.wait(0.2)
    end

    if not alive(id) then return false end

    status("Boss ditemukan | Menunggu HP terbaca...")

    local confirmedAlive = false

    while alive(id) do
        if not boss or not boss.Parent then
            boss = getBoss()
        end

        if boss and boss.Parent then
            local hp = getBossHealth(boss)

            if hp and hp > 0 then
                confirmedAlive = true
                break
            end
        end

        task.wait(0.2)
    end

    if not alive(id) or not confirmedAlive then
        return false
    end

    status("Melawan The Parade Master...")

    while alive(id) do
        if not boss or not boss.Parent then
            return true
        end

        local hp = getBossHealth(boss)

        if hp ~= nil and hp <= 0 then
            return true
        end

        task.wait(0.2)
    end

    return false
end

--============================================================
-- AUTO FEST
--============================================================

local function runOneFest(id)
    updateCharacter()
    if not Root then return false end

    status("Teleport POS1...")
    Root.CFrame = CFrame.new(POS1 + Vector3.new(0, 3, 0))

    task.wait(0.3)

    if not alive(id) then return false end

    status("Lari menuju POS2...")

    if not moveToPosition(POS2, function()
        return alive(id)
    end, "POS2", 5) then
        return false
    end

    task.wait(2)

    if not alive(id) then return false end

    status("EnterDungeon FEST...")

    local ok, result = pcall(function()
        return RequestRemote:InvokeServer(
            "EnterDungeon",
            DUNGEON,
            DUNGEON_COUNT
        )
    end)

    if not ok then
        status("EnterDungeon error: " .. tostring(result))
        return false
    end

    if result == false then
        status("EnterDungeon ditolak.")
        return false
    end

    -- FEST SUDAH DIMASUKI:
    -- NYALAKAN SWING + HIT, SKILL, DODGE
    setFestCombat(true)

    status("Mencari FloorGlow...")

    local floorGlow

    while alive(id) do
        local door = getDungeonObject({"BossDoor"})
        floorGlow = door and door:FindFirstChild("FloorGlow")

        if floorGlow then break end

        task.wait(0.1)
    end

    if not alive(id) then return false end

    if not clearDungeon(id, floorGlow) then
        return false
    end

    status("FloorGlow tercapai | Menunggu boss...")
    task.wait(2)

    if not alive(id) then return false end

    if not waitBossDefeated(id) then
        return false
    end

    if not alive(id) then return false end

    status("Boss kalah | LeaveDungeon...")

    local leaveOK, leaveError = pcall(function()
        RequestRemote:InvokeServer("LeaveDungeon")
    end)

    if not leaveOK then
        status("LeaveDungeon error: " .. tostring(leaveError))
        return false
    end

    -- LEAVE BERHASIL:
    -- MATIKAN SWING + HIT, SKILL, DODGE
    setFestCombat(false)

    task.wait(1)

    return true
end

--============================================================
-- START / STOP FEST
--============================================================

local function stopFest()
    AutoFest = false
    FestRunId += 1

    setToggle("AUTO FEST", false)

    -- AUTO FEST DIMATIKAN MANUAL:
    -- MATIKAN 3 TOGGLE COMBAT JUGA
    setFestCombat(false)

    updateCharacter()

    if Humanoid and Root then
        Humanoid:MoveTo(Root.Position)
    end

    status("AUTO FEST dihentikan.")
end

local function startFest()
    if AutoFest then return end

    AutoFest = true
    FestRunId += 1

    local id = FestRunId

    setToggle("AUTO FEST", true)
    status("Memulai AUTO FEST...")

    task.spawn(function()
        while alive(id) do
            local success, result = pcall(function()
                return runOneFest(id)
            end)

            if not alive(id) then
                break
            end

            if not success then
                status("ERROR: " .. tostring(result) .. " | Retry 5 detik")
                task.wait(5)

            elseif result then
                status("Dungeon selesai | Menyiapkan FEST berikutnya...")
                task.wait(1)

            else
                status("Putaran gagal | Mencoba ulang 5 detik...")
                task.wait(5)
            end
        end

        if FestRunId == id then
            AutoFest = false
            setToggle("AUTO FEST", false)
            setFestCombat(false)
            status("AUTO FEST berhenti.")
        end
    end)
end

