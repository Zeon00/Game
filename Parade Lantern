--BOSS

local function getBoss()

    local enemies = Workspace:FindFirstChild("Enemies")

    if not enemies then return nil end

    return enemies:FindFirstChild(ActiveConfig.BOSS)

end

local function getBossHealth(boss)

    if not boss then return nil end

    local hum = boss:FindFirstChildOfClass("Humanoid")

    if hum then

        return hum.Health

    end

    local health = boss:FindFirstChild("Health")

    if health and (health:IsA("NumberValue") or health:IsA("IntValue")) then

        return health.Value

    end

    local attribute = boss:GetAttribute("Health")

    if typeof(attribute) == "number" then

        return attribute

    end

    return nil

end

local function waitBossDefeated(id)
    status("Menunggu " .. ActiveConfig.BOSS .. "...")
    local boss = nil
    local confirmedAlive = false

    -- Cari boss sampai model dan HP siap. Tidak ada pencarian FloorGlow di sini.
    while alive(id) do
        if not boss or not boss.Parent then boss = getBoss() end
        if boss and boss.Parent then
            -- Dodge baru ON saat model boss benar-benar muncul di Workspace.Enemies.
            activateBossPhaseDodge()
            local hp = getBossHealth(boss)
            if hp ~= nil then
                if hp <= 0 then
                    status("HP Boss 0 | BOSS KALAH!")
                    return true
                end
                confirmedAlive = true
                break
            end
        end
        task.wait(0.2)
    end
    if not alive(id) then return false end

    status("Boss ditemukan | Mendekati " .. ActiveConfig.BOSS .. "...")
    local lastBossMove = 0

    -- Dekati boss; jika root belum siap, tunggu tanpa reset ke FloorGlow.
    while alive(id) and boss and boss.Parent do
        updateCharacter()
        local bossRoot = getMobRoot(boss)
        if bossRoot and Root and Humanoid then
            local distance = (Root.Position - bossRoot.Position).Magnitude
            if distance <= 8 then break end
            if os.clock() - lastBossMove >= 0.4 then
                Humanoid:MoveTo(bossRoot.Position)
                lastBossMove = os.clock()
            end
            status("Menuju boss | " .. math.floor(distance) .. " studs")
        end
        local hp = getBossHealth(boss)
        if hp ~= nil and hp <= 0 then
            status("HP Boss 0 | BOSS KALAH!")
            return true
        end
        task.wait(0.12)
    end

    updateCharacter()
    if Humanoid and Root then Humanoid:MoveTo(Root.Position) end
    status("Melawan " .. ActiveConfig.BOSS .. "...")

    -- Pantau boss yang sama sampai HP 0 / model hilang.
    while alive(id) do
        if not boss or not boss.Parent then
            if confirmedAlive then
                status("Boss menghilang | DIANGGAP KALAH!")
                return true
            end
            boss = getBoss()
            if not boss then
                task.wait(0.2)
                continue
            end
        end
        local hp = getBossHealth(boss)
        if hp ~= nil then
            if hp <= 0 then
                status("HP Boss 0 | BOSS KALAH!")
                return true
            end
            confirmedAlive = true
        end
        task.wait(0.15)
    end
    return false
end

local function bossDead(boss)

    if not boss or not boss.Parent then return true end

    return isDead(boss)

end

--COMBAT AUTO CONTROL

local function setAutoDodge(enabled)

    AutoDodge = enabled and true or false

    setToggle("AUTO DODGE", AutoDodge)

end

local function setFestCombat(enabled)

    if enabled then

        startCombat()

        startSkill()

        -- Dodge TP sengaja belum aktif saat perjalanan menuju FloorGlow.

        setAutoDodge(false)

        setToggle("SWING + HIT", true)

        setToggle("AUTO SKILL", true)

    else

        stopCombat()

        stopSkill()

        setAutoDodge(false)

        setToggle("SWING + HIT", false)

        setToggle("AUTO SKILL", false)

    end

end

pauseDungeonForRestock = function()
    if RestockLeaving then return end

    RestockLeaving = true

    -- Hentikan combat dan dodge selama keluar dungeon.
    setFestCombat(false)
    setAutoDodge(false)

    updateCharacter()

    if Humanoid and Root then
        Humanoid:MoveTo(Root.Position)
    end

    -- Leave Dungeon langsung, tidak menunggu boss atau dungeon selesai.
    local leaveOK, leaveResult = pcall(function()
        return RequestRemote:InvokeServer("LeaveDungeon")
    end)

    if not leaveOK or leaveResult == false then
        warn("[RESTOCK] LeaveDungeon gagal:", leaveResult)
        status("LeaveDungeon gagal | Akan lanjut mencoba...")
    else
        status("LeaveDungeon terkirim | Menuju EventShopZone...")
    end

    RestockLeaving = false
end

local function finishBossPhase(id)
    if not BossPhaseActive then return false end

    if not BossPhaseDelayDone then
        status("FloorGlow tercapai | Fase boss dikunci | Tunggu 2 detik...")
        task.wait(2)
        BossPhaseDelayDone = true
    end

    while alive(id) do
        if waitBossDefeated(id) then break end
        if alive(id) then
            status("Fase boss aktif | Menunggu boss, tidak mencari FloorGlow...")
            task.wait(1)
        end
    end
    if not alive(id) then return false end

    status("BOSS KALAH | Auto Dodge OFF | LeaveDungeon " .. ActiveConfig.DUNGEON .. "...")
    setAutoDodge(false)
    setFestCombat(false)

    -- Tetap di fase boss sampai LeaveDungeon benar-benar diterima.
    while alive(id) do
        local leaveOK, leaveResult = pcall(function()
            return RequestRemote:InvokeServer("LeaveDungeon")
        end)
        if leaveOK and leaveResult ~= false then
            BossPhaseActive = false
            BossPhaseDelayDone = false
            status(ActiveConfig.DUNGEON .. " selesai | Menyiapkan POS1 berikutnya...")
            task.wait(1)
            return true
        end
        status("LeaveDungeon belum berhasil | Tetap di fase boss, retry 2 detik...")
        task.wait(2)
    end
    return false
end

local function runOneDungeon(id)

    if BossPhaseActive then
        status("Melanjutkan fase boss | FloorGlow dikunci, tidak dicari ulang...")
        return finishBossPhase(id)
    end
    BossPhaseDelayDone = false

    updateCharacter()

    if not Root then return false end

    if ActiveMode == "X7" then

        X7BlockPassed = false

    elseif ActiveMode == "FEST" then

        FestBlockPassed = false

    end

    status("[" .. ActiveMode .. "] Teleport POS1...")

    Root.CFrame = CFrame.new(ActiveConfig.POS1 + ActiveConfig.POS1_OFFSET)

    task.wait(0.3)

    if not alive(id) then return false end

    status("[" .. ActiveMode .. "] Lari menuju POS2...")

    if not moveToPosition(ActiveConfig.POS2, function() return alive(id) end, "POS2", 5) then

        return false

    end

    task.wait(2)

    if not alive(id) then return false end

    status("EnterDungeon " .. ActiveConfig.DUNGEON .. "...")

    local ok, result = pcall(function()

        return RequestRemote:InvokeServer("EnterDungeon", ActiveConfig.DUNGEON, ActiveConfig.COUNT)

    end)

    if not ok then

        status("EnterDungeon error: " .. tostring(result))

        return false

    end

    if result == false then

        status("EnterDungeon ditolak.")

        return false

    end

    setFestCombat(true)

    if ActiveMode == "X7" then

        setAutoDodge(false)

        status(ActiveConfig.DUNGEON .. " masuk | Auto Hit + Skill ON | Dodge OFF")

    else

        status(ActiveConfig.DUNGEON .. " masuk | Auto Hit + Skill ON | Dodge OFF")

    end

    task.wait(0.3)

    local floorGlow

    -- Cek boss lebih dahulu. Jika boss sudah ada di Enemies, jangan cari FloorGlow.
    while alive(id) do

        local enemiesFolder = Workspace:FindFirstChild("Enemies")
        local spawnedBoss = enemiesFolder and enemiesFolder:FindFirstChild(ActiveConfig.BOSS)
        if spawnedBoss and spawnedBoss:IsA("Model") and spawnedBoss.Parent then
            BossPhaseActive = true
            BossPhaseDelayDone = false
            activateBossPhaseDodge()
            break
        end

        local door = getDungeonObject({"BossDoor"})
        floorGlow = door and door:FindFirstChild("FloorGlow")
        if floorGlow then break end

        task.wait(0.1)

    end

    if not alive(id) then return false end

    -- Kalau boss muncul saat menunggu FloorGlow, langsung masuk fase boss.
    if not BossPhaseActive then
        local glowPosition = getObjectPosition(floorGlow)
        if not glowPosition then
            status("FloorGlow tidak punya posisi!")
            return false
        end

        FLOOR_GLOW_POS = glowPosition
        if not clearDungeon(id, floorGlow) then return false end

        -- Bisa saja boss spawn saat karakter sedang bergerak ke FloorGlow.
        if not BossPhaseActive then
            BossPhaseActive = true
            BossPhaseDelayDone = false
            status("FloorGlow tercapai | Perjalanan berhenti | Menunggu boss muncul...")
        end
    end

    if ActiveMode == "X7" then
        setAutoDodge(false)
        status("X7 | Fase boss terkunci | Dodge OFF | Menunggu boss...")
    else
        setAutoDodge(false)
        status("Fase boss terkunci | FloorGlow STOP | Menunggu The Parade Master...")
    end

    if not alive(id) then return false end
    return finishBossPhase(id)

end

local function stopMode(mode)

    if mode == "FEST" then

        AutoFest = false

        FestRunId = FestRunId + 1

        setToggle("AUTO FEST", false)

    else

        AutoX7 = false

        X7RunId = X7RunId + 1

        setToggle("AUTO X7", false)

    end

    setFestCombat(false)
    BossPhaseActive = false
    BossPhaseDelayDone = false

    updateCharacter()

    if Humanoid and Root then Humanoid:MoveTo(Root.Position) end

    status("AUTO " .. mode .. " dihentikan.")

end

local function startMode(mode)

    -- Mutual exclusion: hanya satu mode dungeon boleh aktif.

    if mode == "FEST" then

        if AutoFest then return end

        if AutoX7 then
            stopMode("X7")
        end

        ActiveMode = "FEST"
        ActiveConfig = MODE_CONFIG.FEST
        FLOOR_GLOW_POS = ActiveConfig.FLOOR_GLOW

        AutoFest = true
        FestRunId = FestRunId + 1

        local id = FestRunId

        setToggle("AUTO FEST", true)
        setToggle("AUTO X7", false)

        status("Memulai AUTO FEST...")

        task.spawn(function()

            while Running and AutoFest and FestRunId == id do

                -- PAUSE RESTOCK: toggle FEST tetap ON.
                while Running and AutoFest
                    and FestRunId == id
                    and RestockPaused do

                    task.wait(0.1)
                end

                if not Running or not AutoFest or FestRunId ~= id then
                    break
                end

                local success, result = pcall(runOneDungeon, id)

                -- Jika restock sedang berlangsung, jangan matikan FEST.
                if RestockPaused then
                    task.wait(0.1)
                    continue
                end

                if not Running or not AutoFest or FestRunId ~= id then
                    break
                end

                if not success then
                    status("ERROR FEST: " .. tostring(result))
                    task.wait(2)

                elseif not result then
                    status("FEST gagal | Coba ulang dari POS1...")
                    task.wait(2)

                else
                    status("FEST selesai | Dungeon berikutnya...")
                    task.wait(1)
                end

            end

            -- Hanya OFF jika pengguna benar-benar menghentikan mode.
            if FestRunId == id and not RestockPaused then
                AutoFest = false
                setFestCombat(false)
                setToggle("AUTO FEST", false)
                status("AUTO FEST selesai / berhenti.")
            end

        end)

    else

        if AutoX7 then return end

        if AutoFest then
            stopMode("FEST")
        end

        ActiveMode = "X7"
        ActiveConfig = MODE_CONFIG.X7
        FLOOR_GLOW_POS = ActiveConfig.FLOOR_GLOW

        AutoX7 = true
        X7RunId = X7RunId + 1

        local id = X7RunId

        setToggle("AUTO X7", true)
        setToggle("AUTO FEST", false)

        status("Memulai AUTO X7...")

        task.spawn(function()

            while Running and AutoX7 and X7RunId == id do

                -- PAUSE RESTOCK: toggle X7 tetap ON.
                while Running and AutoX7
                    and X7RunId == id
                    and RestockPaused do

                    task.wait(0.1)
                end

                if not Running or not AutoX7 or X7RunId ~= id then
                    break
                end

                local success, result = pcall(runOneDungeon, id)

                -- Jangan anggap pause restock sebagai kegagalan dungeon.
                if RestockPaused then
                    task.wait(0.1)
                    continue
                end

                if not Running or not AutoX7 or X7RunId ~= id then
                    break
                end

                if not success then

                    status("ERROR X7: " .. tostring(result) .. " | Coba ulang 3 detik...")
                    task.wait(3)

                elseif not result then

                    status("Siklus X7 belum selesai | Ulang dari POS1 dalam 3 detik...")
                    task.wait(3)

                else

                    status("X7 selesai | Ulang dungeon berikutnya...")
                    task.wait(1)

                end

            end

            -- Hanya OFF jika pengguna benar-benar menghentikan mode.
            if X7RunId == id and not RestockPaused then
                AutoX7 = false
                setFestCombat(false)
                setToggle("AUTO X7", false)
                status("AUTO X7 selesai / berhenti.")
            end

        end)

    end

end

local function stopFest()

    if AutoFest then stopMode("FEST") end

end

local function stopX7()

    if AutoX7 then stopMode("X7") end

end

