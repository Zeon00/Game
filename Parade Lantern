local function makeToggle(name, order)
    local button = Instance.new("TextButton")

    button.Name = name
    button.Size = UDim2.new(1, 0, 0, 32)
    button.BackgroundColor3 = Color3.fromRGB(125, 55, 55)
    button.Text = name .. " : OFF"
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 12
    button.Font = Enum.Font.GothamBold
    button.LayoutOrder = order
    button.Parent = ButtonHolder

    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

    ToggleButtons[name] = button

    button.MouseButton1Click:Connect(function()
        local value = not ToggleStates[name]

        if name == "AUTO FEST" then
            if value then
                startMode("FEST")
            else
                stopFest()
            end

        elseif name == "AUTO X7" then
            if value then
                startMode("X7")
            else
                stopX7()
            end

        elseif name == "SWING + HIT" then
            if value then
                startCombat()
            else
                stopCombat()
            end

            setToggle(name, value)

        elseif name == "AUTO SKILL" then
            if value then
                startSkill()
            else
                stopSkill()
            end

            setToggle(name, value)

        elseif name == "AUTO DODGE" then
            AutoDodge = value
            setToggle(name, value)

        elseif name == "AUTO ECLIPSE" then
            if value then
                startEclipse()
            else
                stopEclipse()
            end

        elseif name == "AUTO CLAIM" then
            if value then
                startClaim()
            else
                stopClaim()
            end

        elseif name == "AUTO ENCHANT" then
            if value then
                startEnchant()
            else
                stopEnchant()
            end
        end
    end)
end

for index, name in ipairs(names) do
    makeToggle(name, index)
end

