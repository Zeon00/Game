--FLOOR GLOW: CHECKPOINT TP RETRY + MOVETO FLOOR GLOW

local function moveToFloorGlow(id)

    updateCharacter()

    if not Root or not Humanoid then return false end

    IsGoingToFloorGlow = true

    local oldSpeed = Humanoid.WalkSpeed

    Humanoid.WalkSpeed = math.max(oldSpeed, ActiveConfig.WALK_SPEED)

    local arrived = false

    local lastMove = 0

    while alive(id) and not BossPhaseActive do

        -- PRIORITAS BOSS: jika model boss sudah muncul di Workspace.Enemies,
        -- langsung kunci fase boss dan batalkan perjalanan FloorGlow.
        local enemiesFolder = Workspace:FindFirstChild("Enemies")
        local spawnedBoss = enemiesFolder and enemiesFolder:FindFirstChild(ActiveConfig.BOSS)
        if spawnedBoss and spawnedBoss:IsA("Model") and spawnedBoss.Parent then
            BossPhaseActive = true
            BossPhaseDelayDone = false
            if Humanoid and Root then Humanoid:MoveTo(Root.Position) end
            activateBossPhaseDodge()
            break
        end

        updateCharacter()

        if not Root or not Humanoid or Humanoid.Health <= 0 then

            task.wait(0.2)

            continue

        end

--DETEKSI AREA PENGHALANG TANPA BERJALAN KE BLOCK_CHECK

        local obstacleEnabled =
            (ActiveMode == "X7" and not X7BlockPassed)
            or (ActiveMode == "FEST" and not FestBlockPassed)

        if obstacleEnabled then

            local obstacleDistance =
                (Root.Position - ActiveConfig.BLOCK_CHECK).Magnitude

            if obstacleDistance <= BLOCK_RADIUS then

                -- Kunci sebelum teleport agar hanya terjadi sekali per dungeon.
                if ActiveMode == "X7" then
                    X7BlockPassed = true
                    status("X7 | Penghalang terdeteksi, TP sekali...")
                else
                    FestBlockPassed = true
                    status("FEST | Penghalang terdeteksi, TP bypass sekali...")
                end

                Humanoid:MoveTo(Root.Position)
                task.wait(0.1)

                local oldCF = Root.CFrame
                Root.CFrame =
                    CFrame.new(ActiveConfig.BLOCK_TP)
                    * (oldCF - oldCF.Position)

                Root.AssemblyLinearVelocity = Vector3.zero
                Root.AssemblyAngularVelocity = Vector3.zero

                task.wait(0.2)

                if ActiveMode == "X7" then
                    status("X7 | Lanjut menuju FloorGlow")
                else
                    status("FEST | Bypass penghalang selesai, lanjut menuju FloorGlow")
                end
            end
        end

--SELALU BERJALAN LANGSUNG KE FLOOR GLOW

        local distance = (Root.Position - FLOOR_GLOW_POS).Magnitude

        if distance <= FLOOR_GLOW_RADIUS then

            arrived = true

            break

        end

        if os.clock() - lastMove >= 0.2 then

            Humanoid:MoveTo(FLOOR_GLOW_POS)

            lastMove = os.clock()

        end

        status("Menuju FloorGlow | " .. math.floor(distance) .. " studs")

        task.wait(0.12)

    end

    updateCharacter()

    if Humanoid then

        Humanoid:MoveTo(Root and Root.Position or FLOOR_GLOW_POS)

        Humanoid.WalkSpeed = oldSpeed

    end

    IsGoingToFloorGlow = false

    return arrived or BossPhaseActive

end

local function clearDungeon(id, floorGlow)

    if not floorGlow then

        status("FloorGlow belum ditemukan!")

        return false

    end

    status("Menuju checkpoint dan FloorGlow...")

    local reached = moveToFloorGlow(id)

    if reached then

        status("FloorGlow tercapai!")

    end

    return reached

end

