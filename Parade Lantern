local function bossNameMatches(name)
    local wanted = string.lower(tostring(ActiveConfig.BOSS or ""))
    local actual = string.lower(tostring(name or ""))

    if wanted == "" or actual == "" then
        return false
    end

    return actual == wanted
        or string.find(actual, wanted, 1, true) ~= nil
        or string.find(wanted, actual, 1, true) ~= nil
end

local function getBoss()
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return nil end

    local direct = enemies:FindFirstChild(ActiveConfig.BOSS)
    if direct and direct:IsA("Model") and not isDead(direct) then
        return direct
    end

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob:IsA("Model")
            and bossNameMatches(mob.Name)
            and not isDead(mob) then

            return mob
        end
    end

    return nil
end

local function getBossHealth(boss)
    if not boss then return nil end

    local hum = boss:FindFirstChildOfClass("Humanoid")
    if hum then return hum.Health end

    local health = boss:FindFirstChild("Health")

    if health and (health:IsA("NumberValue") or health:IsA("IntValue")) then
        return health.Value
    end

    local attribute = boss:GetAttribute("Health")

    if typeof(attribute) == "number" then
        return attribute
    end

    return nil
end

local function activateBossPhaseDodge()
    if EclipsePaused or EclipsePriority or EclipseInRun then
        AutoDodge = false
        setToggle("AUTO DODGE", false)
        return
    end

    if ActiveMode == "FEST" then
        AutoDodge = true
        setToggle("AUTO DODGE", true)
        status("The Parade Master | Boss Dodge ON")
    else
        AutoDodge = false
        setToggle("AUTO DODGE", false)
        status("X7 Boss | Dodge OFF")
    end
end

--============================================================
-- FLOOR GLOW
--============================================================

local function moveToFloorGlow(id)
    updateCharacter()

    if not Root or not Humanoid then return false end

    IsGoingToFloorGlow = true

    local oldSpeed = Humanoid.WalkSpeed
    Humanoid.WalkSpeed = math.max(oldSpeed, ActiveConfig.WALK_SPEED)

    local arrived = false
    local lastMove = 0

    while alive(id) and not BossPhaseActive do
        local spawnedBoss = getBoss()

        if spawnedBoss then
            BossPhaseActive = true
            BossPhaseDelayDone = false
            activateBossPhaseDodge()
            break
        end

        updateCharacter()

        if not Root or not Humanoid or Humanoid.Health <= 0 then
            task.wait(0.2)
            continue
        end

        local obstacleEnabled =
            (ActiveMode == "X7" and not X7BlockPassed)
            or (ActiveMode == "FEST" and not FestBlockPassed)

        if obstacleEnabled then
            local obstacleDistance =
                (Root.Position - ActiveConfig.BLOCK_CHECK).Magnitude

            if obstacleDistance <= BLOCK_RADIUS then
                if ActiveMode == "X7" then
                    X7BlockPassed = true
                    status("X7 | Bypass penghalang...")
                else
                    FestBlockPassed = true
                    status("FEST | Bypass penghalang...")
                end

                Humanoid:MoveTo(Root.Position)
                task.wait(0.1)

                local oldCF = Root.CFrame

                Root.CFrame =
                    CFrame.new(ActiveConfig.BLOCK_TP)
                    * (oldCF - oldCF.Position)

                Root.AssemblyLinearVelocity = Vector3.zero
                Root.AssemblyAngularVelocity = Vector3.zero

                task.wait(0.2)
            end
        end

        local distance = (Root.Position - FLOOR_GLOW_POS).Magnitude

        if distance <= FLOOR_GLOW_RADIUS then
            arrived = true
            break
        end

        if os.clock() - lastMove >= 0.2 then
            Humanoid:MoveTo(FLOOR_GLOW_POS)
            lastMove = os.clock()
        end

        status("Menuju FloorGlow | " .. math.floor(distance) .. " studs")
        task.wait(0.12)
    end

    updateCharacter()

    if Humanoid then
        Humanoid:MoveTo(Root and Root.Position or FLOOR_GLOW_POS)
        Humanoid.WalkSpeed = oldSpeed
    end

    IsGoingToFloorGlow = false

    return arrived or BossPhaseActive
end

local function clearDungeon(id, floorGlow)
    if not floorGlow then
        status("FloorGlow belum ditemukan!")
        return false
    end

    status("Menuju FloorGlow...")
    return moveToFloorGlow(id)
end

