-- Input Dungeon ID + Star (contoh: X7, X11, S3, A5, D2, C4, R1)
local X7DungeonInput = "X7"
local X7StarInput = "19"

local function resolveX7Config()
    local dungeonId = string.upper(
        tostring(X7DungeonInput):gsub("%s+", "")
    )

    local star = tonumber(X7StarInput)

    if dungeonId == "" then
        return nil, "Dungeon ID belum diisi"
    end

    if not dungeonId:match("^[A-Z]%d+$") then
        return nil, "Format ID salah. Contoh: X7, X11, S3, A5, D2, C4, R1"
    end

    if not star or star < 1 or star % 1 ~= 0 then
        return nil, "Star harus angka bulat minimal 1"
    end

    local ok, entry = pcall(function()
        return DungeonConfig.get(dungeonId)
    end)

    if not ok or not entry then
        return nil, "Dungeon " .. dungeonId .. " tidak ditemukan"
    end

    if entry.Id and string.upper(tostring(entry.Id)) ~= dungeonId then
        return nil, "Dungeon ID tidak cocok"
    end

    local maxStar = tonumber(entry.MaxStar)

    if maxStar and star > maxStar then
        return nil, "Maksimal Star " .. dungeonId .. " adalah " .. maxStar
    end

    local config = table.clone(MODE_CONFIG.X7)

    config.DUNGEON = entry.Id or dungeonId
    config.COUNT = star
    config.BOSS = entry.Boss or config.BOSS

    return config
end

