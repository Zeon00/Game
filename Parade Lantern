local BossOrbitRunning = false

local function startBossOrbit(id, boss)
    if BossOrbitRunning then return end
    BossOrbitRunning = true
    setToggle("AUTO ORBIT", true)

    task.spawn(function()
        local angle = 0
        local lastClock = os.clock()
        local lastMove = 0
        local lastJump = 0
        local direction = 1
        local oldSpeed
        local target = boss

        local function getOrbitTarget()
            -- Prioritas: boss hidup. Jika nama/struktur boss tidak cocok,
            -- orbit tetap bisa memakai model musuh hidup di folder Enemies.
            if target and target.Parent and not isDead(target) and getMobRoot(target) then
                return target
            end

            local folder = Workspace:FindFirstChild("Enemies")
            if not folder then return nil end

            local fallback
            for _, mob in ipairs(folder:GetChildren()) do
                if mob:IsA("Model") and not isDead(mob) and getMobRoot(mob) then
                    if bossNameMatches(mob.Name) then
                        target = mob
                        return mob
                    end
                    fallback = fallback or mob
                end
            end

            if fallback then
                target = fallback
                return fallback
            end

            return nil
        end

        local function getFloorPosition(candidate, char, mob)
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = {char, mob}
            params.IgnoreWater = true

            local result = Workspace:Raycast(
                candidate + Vector3.new(0, 12, 0),
                Vector3.new(0, -35, 0),
                params
            )

            if not result or result.Normal.Y < 0.75
                or result.Material == Enum.Material.Water then
                return nil
            end

            return result.Position
        end

        while alive(id) and BossPhaseActive do
            updateCharacter()
            if not Character or not Root or not Humanoid then
                task.wait(0.2)
                continue
            end

            local currentTarget = getOrbitTarget()
            if not currentTarget then
                status("Boss Orbit | Menunggu boss di workspace.Enemies...")
                task.wait(0.2)
                continue
            end

            local mobRoot = getMobRoot(currentTarget)
            if not mobRoot then
                task.wait(0.1)
                continue
            end

            if oldSpeed == nil then oldSpeed = Humanoid.WalkSpeed end
            Humanoid.WalkSpeed = 50

            -- Tunggu server memindahkan pemain dari FloorGlow ke Boss Room.
            -- Tidak ada teleport atau MoveTo mengejar boss dari FloorGlow.
            local distance = (Root.Position - mobRoot.Position).Magnitude
            if distance > 40 then
                status("Menunggu masuk Boss Room | " .. math.floor(distance) .. " studs")
                task.wait(0.12)
                lastClock = os.clock()
                continue
            end

            status("Boss Orbit: " .. currentTarget.Name)

            local now = os.clock()
            local dt = math.min(now - lastClock, 0.25)
            lastClock = now
            angle = angle + (BOSS_ORBIT_SPEED * dt * direction)

            -- Auto jump setiap 1.1 detik seperti standalone orbit.
            if now - lastJump >= 1.1 then
                Humanoid.Jump = true
                lastJump = now
            end

            if now - lastMove >= 0.12 then
                local center = mobRoot.Position
                local candidate = center + Vector3.new(
                    math.cos(angle) * BOSS_ORBIT_RADIUS,
                    0,
                    math.sin(angle) * BOSS_ORBIT_RADIUS
                )

                local floorPosition = getFloorPosition(candidate, Character, currentTarget)
                if floorPosition then
                    local destination = floorPosition + Vector3.new(
                        0,
                        Humanoid.HipHeight + Root.Size.Y / 2 + 0.15,
                        0
                    )
                    Humanoid:MoveTo(destination)
                else
                    direction = direction * -1
                    angle = angle + direction * 0.7
                end

                lastMove = now
            end

            task.wait(0.035)
        end

        updateCharacter()
        if Humanoid then
            Humanoid:MoveTo(Root and Root.Position or Vector3.zero)
            Humanoid.Jump = false
            if oldSpeed then Humanoid.WalkSpeed = oldSpeed end
        end

        BossOrbitRunning = false
        setToggle("AUTO ORBIT", false)
    end)
end

