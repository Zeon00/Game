local function getCurrentEclipse()
    local attribute = Workspace:GetAttribute("EclipseDungeon")

    if not attribute then return nil, nil end

    local ok, config = pcall(function()
        return DungeonConfig.get(attribute)
    end)

    if not ok or not config or not config.Id then
        return nil, attribute
    end

    return config, attribute
end

local function getEclipseWorld(config)
    if not config then return nil end

    local ok, world = pcall(function()
        return DungeonConfig.worldOf(config)
    end)

    if not ok then return nil end

    return tonumber(world)
end

local function findUmbra()
    local enemies = Workspace:FindFirstChild("Enemies")
    local mob = enemies and enemies:FindFirstChild("Umbra the Sun-Eater")

    if mob and mob:IsA("Model") and not isDead(mob) then
        return mob
    end

    return nil
end

local function teleportToUmbra(mob)
    if not mob or not mob.Parent or isDead(mob) then return false end

    updateCharacter()

    if not Root then return false end

    local mobRoot = getMobRoot(mob)

    if not mobRoot then return false end

    return pcall(function()
        local destination = mobRoot.CFrame * CFrame.new(0, 0, 5)

        Root.CFrame = CFrame.lookAt(destination.Position, mobRoot.Position)

        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function teleportEclipsePosition(position)
    updateCharacter()

    if not Root then return false end

    return pcall(function()
        Root.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))

        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function pauseModesForEclipse()
    if EclipsePaused then return end

    EclipseSavedFest = AutoFest
    EclipseSavedX7 = AutoX7
    EclipseSavedCombat = AutoCombat
    EclipseSavedSkill = AutoSkill
    EclipseSavedDodge = AutoDodge

    EclipsePaused = true
    EclipsePriority = true

    -- OFF-kan toggle dan batalkan loop FEST
    if EclipseSavedFest then
        AutoFest = false
        FestRunId += 1
        setToggle("AUTO FEST", false)
    end

    -- OFF-kan toggle dan batalkan loop X7
    if EclipseSavedX7 then
        AutoX7 = false
        X7RunId += 1
        setToggle("AUTO X7", false)
    end

    stopCombat()
    stopSkill()
    setAutoDodge(false)

    updateCharacter()

    if Humanoid and Root then
        Humanoid:MoveTo(Root.Position)
    end

    status("ECLIPSE PRIORITY | FEST/X7 OFF sementara")
end
local function restoreModesAfterEclipse()
    if not EclipsePaused then return end

    local resumeFest = EclipseSavedFest
    local resumeX7 = EclipseSavedX7

    EclipseTarget = nil
    CurrentDungeonTarget = nil

    if EclipseSavedCombat then
        startCombat()
        setToggle("SWING + HIT", true)
    else
        stopCombat()
        setToggle("SWING + HIT", false)
    end

    if EclipseSavedSkill then
        startSkill()
        setToggle("AUTO SKILL", true)
    else
        stopSkill()
        setToggle("AUTO SKILL", false)
    end

    setAutoDodge(EclipseSavedDodge)

    EclipsePaused = false
    EclipsePriority = false

    AutoFest = false
    AutoX7 = false

    -- Mulai ulang loop dari awal, bukan melanjutkan loop lama
    if resumeFest then
        setToggle("AUTO X7", false)
        startMode("FEST")
    elseif resumeX7 then
        setToggle("AUTO FEST", false)
        startMode("X7")
    else
        setToggle("AUTO FEST", false)
        setToggle("AUTO X7", false)
    end

    EclipseSavedFest = false
    EclipseSavedX7 = false
    EclipseSavedCombat = false
    EclipseSavedSkill = false
    EclipseSavedDodge = false

    status("ECLIPSE SELESAI | Mode sebelumnya dimulai ulang")
end

local function stopEclipse()
    AutoEclipse = false

    setToggle("AUTO ECLIPSE", false)

    if not EclipseInRun then
        EclipseRunId += 1
        restoreModesAfterEclipse()
        status("AUTO ECLIPSE OFF")
    else
        status("AUTO ECLIPSE OFF | Menyelesaikan Eclipse aktif dulu...")
    end
end

local function startEclipse()
    if not Running or AutoEclipse then return end

    AutoEclipse = true
    EclipseRunId += 1

    local id = EclipseRunId

    setToggle("AUTO ECLIPSE", true)
    status("AUTO ECLIPSE ON | Memantau Eclipse...")

    task.spawn(function()
        local function alive()
            return Running
                and EclipseRunId == id
                and (AutoEclipse or EclipseInRun)
        end

        local function eclipseStatus(message)
            status("ECLIPSE | " .. tostring(message))
        end

        local function waitWorld(targetWorld)
            local currentWorld = tonumber(Player:GetAttribute("World")) or 1

            if currentWorld == targetWorld then
                eclipseStatus("Sudah berada di World " .. targetWorld)
                return true
            end

            local lobbyName = currentWorld == 1 and "Lobby"
                or currentWorld == 2 and "Lobby2"

            if not lobbyName then
                eclipseStatus("World saat ini tidak dikenal: " .. tostring(currentWorld))
                return false
            end

            local lobby = Workspace:FindFirstChild(lobbyName)
            local zones = lobby and lobby:FindFirstChild("Zones")
            local portal = zones and zones:FindFirstChild("WorldPortal")

            if not portal then
                eclipseStatus("Portal World " .. currentWorld .. " tidak ditemukan")
                return false
            end

            local portalPart

            if portal:IsA("BasePart") then
                portalPart = portal
            elseif portal:IsA("Model") then
                portalPart = portal.PrimaryPart
                    or portal:FindFirstChildWhichIsA("BasePart", true)
            else
                portalPart = portal:FindFirstChildWhichIsA("BasePart", true)
            end

            if not portalPart then
                eclipseStatus("Part portal tidak ditemukan")
                return false
            end

            updateCharacter()

            if not Root then return false end

            eclipseStatus("Menuju portal World " .. currentWorld)

            Root.CFrame = portalPart.CFrame * CFrame.new(0, 3, 5)

            task.wait(1)

            if not alive() then return false end

            eclipseStatus("Travel ke World " .. targetWorld)

            local ok, result = pcall(function()
                return RequestRemote:InvokeServer("Travel", targetWorld)
            end)

            if not ok or result == false then
                eclipseStatus("Travel gagal: " .. tostring(result))
                return false
            end

            local deadline = os.clock() + 30

            while alive() and os.clock() < deadline do
                currentWorld = tonumber(Player:GetAttribute("World")) or 1

                if currentWorld == targetWorld then
                    eclipseStatus("Berhasil masuk World " .. targetWorld)
                    return true
                end

                task.wait(0.2)
            end

            eclipseStatus("World belum berubah ke " .. targetWorld)

            return false
        end

        local function waitDungeonEntry()
            eclipseStatus("Menunggu masuk Eclipse...")

            while alive() do
                if Player:GetAttribute("Dungeon") then
                    return true
                end

                task.wait(0.2)
            end

            return false
        end

        local function waitUmbra()
            eclipseStatus("Mencari Umbra the Sun-Eater...")

            while alive() and Player:GetAttribute("Dungeon") do
                local mob = findUmbra()

                if mob then return mob end

                task.wait(0.2)
            end

            return nil
        end

        local function leaveCurrentDungeon()
            if not Player:GetAttribute("Dungeon") then
                return true
            end

            eclipseStatus("FEST/X7 dipause | Langsung LeaveDungeon...")

            if not alive() then return false end

            local leaveOK, leaveResult = pcall(function()
                return RequestRemote:InvokeServer("LeaveDungeon")
            end)

            if not leaveOK then
                eclipseStatus("LeaveDungeon error: " .. tostring(leaveResult))
                return false
            end

            local deadline = os.clock() + 20

            while alive()
                and Player:GetAttribute("Dungeon")
                and os.clock() < deadline do

                task.wait(0.2)
            end

            return not Player:GetAttribute("Dungeon")
        end

        while alive() and AutoEclipse do
            local config, attribute = getCurrentEclipse()

            if not config then
                if Player:GetAttribute("Dungeon") then
                    task.wait(0.5)
                else
                    eclipseStatus("Memantau EclipseDungeon...")
                    task.wait(0.8)
                end

                continue
            end

            local targetWorld = getEclipseWorld(config)

            if targetWorld ~= 1 and targetWorld ~= 2 then
                eclipseStatus("World Eclipse tidak valid: " .. tostring(targetWorld))
                task.wait(2)
                continue
            end

            EclipseInRun = true

            pauseModesForEclipse()

            eclipseStatus("Eclipse terdeteksi: " .. tostring(attribute)
                .. " | World " .. tostring(targetWorld))

            if not leaveCurrentDungeon() then
                eclipseStatus("LeaveDungeon belum berhasil | Retry...")

                task.wait(2)

                EclipseInRun = false
                restoreModesAfterEclipse()

                continue
            end

            if not alive() then break end

            if not waitWorld(targetWorld) then
                if not alive() then break end

                task.wait(2)

                EclipseInRun = false
                restoreModesAfterEclipse()

                continue
            end

            local latestConfig = getCurrentEclipse()

            if not latestConfig then
                eclipseStatus("Eclipse sudah tidak tersedia")

                EclipseInRun = false
                restoreModesAfterEclipse()

                task.wait(1)

                continue
            end

            local latestWorld = getEclipseWorld(latestConfig)

            if latestWorld ~= targetWorld then
                eclipseStatus("World Eclipse berubah | Scan ulang")

                EclipseInRun = false
                restoreModesAfterEclipse()

                task.wait(1)

                continue
            end

            if Player:GetAttribute("Dungeon") then
                if not leaveCurrentDungeon() then
                    eclipseStatus("Masih berada di dungeon, retry...")
                    task.wait(2)
                    continue
                end
            end

            eclipseStatus("Memanggil EclipseEnter...")

            local enterOK, enterResult = pcall(function()
                return PlayerState.request("EclipseEnter", latestConfig.Id)
            end)

            if not enterOK or enterResult == false then
                eclipseStatus("EclipseEnter gagal: " .. tostring(enterResult))

                EclipseInRun = false
                restoreModesAfterEclipse()

                task.wait(3)

                continue
            end

            if not waitDungeonEntry() then break end
            if not alive() then break end

            local umbra = waitUmbra()

            if not alive() then break end

            if not umbra then
                eclipseStatus("Umbra tidak ditemukan / dungeon sudah berakhir")
            else
                EclipseTarget = umbra
                CurrentDungeonTarget = umbra

                eclipseStatus("Umbra ditemukan | TP ke Umbra...")

                if not teleportToUmbra(umbra) then
                    for attempt = 1, 10 do
                        if not alive() or isDead(umbra) then break end

                        if teleportToUmbra(umbra) then break end

                        task.wait(0.3)
                    end
                end

                startCombat()
                startSkill()
                setAutoDodge(true)

                setToggle("SWING + HIT", true)
                setToggle("AUTO SKILL", true)

                eclipseStatus("SWING + HIT + SKILL + DODGE aktif | Fokus Umbra...")

                while alive() and umbra.Parent and not isDead(umbra) do
                    task.wait(0.2)
                end

                if not alive() then break end

                eclipseStatus("Umbra tumbang | Menunggu model hilang...")

                local disappearDeadline = os.clock() + 30

                while alive() and os.clock() < disappearDeadline do
                    local enemies = Workspace:FindFirstChild("Enemies")

                    if not (enemies and enemies:FindFirstChild("Umbra the Sun-Eater")) then
                        break
                    end

                    task.wait(0.15)
                end

                local enemies = Workspace:FindFirstChild("Enemies")

                if enemies and enemies:FindFirstChild("Umbra the Sun-Eater") then
                    eclipseStatus("Umbra masih terdeteksi | Menunggu...")
                    task.wait(2)
                end
            end

            if not alive() then break end

            EclipseTarget = nil
            CurrentDungeonTarget = nil

            if Player:GetAttribute("Dungeon") then
                eclipseStatus("Mengirim LeaveDungeon Eclipse...")

                local left = false

                for attempt = 1, 5 do
                    if not alive() then break end

                    if not Player:GetAttribute("Dungeon") then
                        left = true
                        break
                    end

                    pcall(function()
                        RequestRemote:InvokeServer("LeaveDungeon")
                    end)

                    local deadline = os.clock() + 5

                    while alive()
                        and Player:GetAttribute("Dungeon")
                        and os.clock() < deadline do

                        task.wait(0.2)
                    end
                end

                left = left or not Player:GetAttribute("Dungeon")

                if not left then
                    eclipseStatus("LeaveDungeon belum berhasil | Akan coba lagi")
                    task.wait(2)
                    continue
                end
            end

            if not alive() then break end

            eclipseStatus("Berhasil keluar dari Eclipse")

            if targetWorld == 1 then
                local travelled = false

                while alive() and not travelled do
                    travelled = waitWorld(2)

                    if not travelled then
                        eclipseStatus("Travel World 2 retry...")
                        task.wait(2)
                    end
                end
            end

            if not alive() then break end

            task.wait(2)

            local world2Position = Vector3.new(
                -0.013201752677559853,
                4014.997802734375,
                -118.85517883300781
            )

            eclipseStatus("Menuju posisi 1 World 2...")

            local moved = false

            while alive() and not moved do
                moved = teleportEclipsePosition(world2Position)

                if not moved then
                    updateCharacter()
                    task.wait(0.5)
                end
            end

            if not alive() then break end

            -- Karakter sudah berada di World 2 POS1
eclipseStatus("World 2 POS1 tercapai | Menunggu posisi stabil...")

task.wait(1.5)

if not alive() then break end

EclipseInRun = false
restoreModesAfterEclipse()

eclipseStatus("Selesai | FEST/X7 ON ulang dari POS1")

            task.wait(1)
        end

        EclipseInRun = false
        restoreModesAfterEclipse()

        if EclipseRunId == id then
            setToggle("AUTO ECLIPSE", false)

            if AutoEclipse then
                AutoEclipse = false
            end
        end

        if not AutoEclipse then
            status("AUTO ECLIPSE OFF")
        end
    end)
end

local function finishBossPhase(id)
    if not BossPhaseActive then return false end

    if not BossPhaseDelayDone then
        status("FloorGlow tercapai | Fase boss dikunci | Tunggu 2 detik...")
        task.wait(2)
        BossPhaseDelayDone = true
    end

    while alive(id) do
        if waitBossDefeated(id) then break end

        if alive(id) then
            status("Fase boss aktif | Menunggu boss, tidak mencari FloorGlow...")
            task.wait(1)
        end
    end

    if not alive(id) then return false end

    status("BOSS KALAH | Auto Dodge OFF | LeaveDungeon " .. ActiveConfig.DUNGEON .. "...")

    setAutoDodge(false)
    setFestCombat(false)

    while alive(id) do
        local leaveOK, leaveResult = pcall(function()
            return RequestRemote:InvokeServer("LeaveDungeon")
        end)

        if leaveOK and leaveResult ~= false then
            BossPhaseActive = false
            BossPhaseDelayDone = false

            status(ActiveConfig.DUNGEON .. " selesai | Menyiapkan POS1 berikutnya...")

            task.wait(1)

            return true
        end

        status("LeaveDungeon belum berhasil | Tetap di fase boss, retry 2 detik...")

        task.wait(2)
    end

    return false
end

local function runOneDungeon(id)
    if BossPhaseActive then
        status("Melanjutkan fase boss | FloorGlow dikunci, tidak dicari ulang...")
        return finishBossPhase(id)
    end

    BossPhaseDelayDone = false

    updateCharacter()

    if not Root then return false end

    if ActiveMode == "X7" then
        X7BlockPassed = false
    elseif ActiveMode == "FEST" then
        FestBlockPassed = false
    end

    status("[" .. ActiveMode .. "] Teleport POS1...")

    Root.CFrame = CFrame.new(ActiveConfig.POS1 + ActiveConfig.POS1_OFFSET)

    task.wait(0.3)

    if not alive(id) then return false end

    status("[" .. ActiveMode .. "] Lari menuju POS2...")

    if not moveToPosition(
        ActiveConfig.POS2,
        function()
            return alive(id)
        end,
        "POS2",
        5
    ) then
        return false
    end

    task.wait(2)

    if not alive(id) then return false end

    status("EnterDungeon " .. ActiveConfig.DUNGEON .. "...")

    local ok, result = pcall(function()
        return RequestRemote:InvokeServer(
            "EnterDungeon",
            ActiveConfig.DUNGEON,
            ActiveConfig.COUNT
        )
    end)

    if not ok then
        status("EnterDungeon error: " .. tostring(result))
        return false
    end

    if result == false then
        status("EnterDungeon ditolak.")
        return false
    end

    setFestCombat(true)

    if ActiveMode == "X7" then
        setAutoDodge(false)
        status(ActiveConfig.DUNGEON .. " masuk | Auto Hit + Skill ON | Dodge OFF")
    else
        status(ActiveConfig.DUNGEON .. " masuk | Auto Hit + Skill ON | Dodge OFF")
    end

    task.wait(0.3)

    local floorGlow

    while alive(id) do
        local enemiesFolder = Workspace:FindFirstChild("Enemies")
        local spawnedBoss = enemiesFolder and enemiesFolder:FindFirstChild(ActiveConfig.BOSS)

        if spawnedBoss and spawnedBoss:IsA("Model") and spawnedBoss.Parent then
            BossPhaseActive = true
            BossPhaseDelayDone = false
            activateBossPhaseDodge()
            break
        end

        local door = getDungeonObject({"BossDoor"})

        floorGlow = door and door:FindFirstChild("FloorGlow")

        if floorGlow then break end

        task.wait(0.1)
    end

    if not alive(id) then return false end

    if not BossPhaseActive then
        local glowPosition = getObjectPosition(floorGlow)

        if not glowPosition then
            status("FloorGlow tidak punya posisi!")
            return false
        end

        FLOOR_GLOW_POS = glowPosition

        if not clearDungeon(id, floorGlow) then
            return false
        end

        if not BossPhaseActive then
            BossPhaseActive = true
            BossPhaseDelayDone = false

            status("FloorGlow tercapai | Perjalanan berhenti | Menunggu boss muncul...")
        end
    end

    if ActiveMode == "X7" then
        setAutoDodge(false)
        status("X7 | Fase boss terkunci | Dodge OFF | Menunggu boss...")
    else
        setAutoDodge(false)
        status("Fase boss terkunci | FloorGlow STOP | Menunggu The Parade Master...")
    end

    if not alive(id) then return false end

    return finishBossPhase(id)
end

local function stopMode(mode)
    if mode == "FEST" then
        AutoFest = false
        FestRunId = FestRunId + 1

        setToggle("AUTO FEST", false)
    else
        AutoX7 = false
        X7RunId = X7RunId + 1

        setToggle("AUTO X7", false)
    end

    if EclipsePaused then
        if mode == "FEST" then
            EclipseSavedFest = false
        else
            EclipseSavedX7 = false
        end
    else
        setFestCombat(false)
    end

    BossPhaseActive = false
    BossPhaseDelayDone = false

    updateCharacter()

    if Humanoid and Root then
        Humanoid:MoveTo(Root.Position)
    end

    status("AUTO " .. mode .. " dihentikan.")
end

startMode = function(mode)
    if EclipsePaused or EclipsePriority then
        status("ECLIPSE sedang prioritas | FEST/X7 menunggu")
        return
    end

    if mode == "FEST" then
        if AutoFest then return end

        if AutoX7 then
            stopMode("X7")
        end

        ActiveMode = "FEST"
        ActiveConfig = MODE_CONFIG.FEST
        FLOOR_GLOW_POS = ActiveConfig.FLOOR_GLOW

        AutoFest = true
        FestRunId = FestRunId + 1

        local id = FestRunId

        setToggle("AUTO FEST", true)
        setToggle("AUTO X7", false)

        status("Memulai AUTO FEST...")

        task.spawn(function()
            while Running and AutoFest and FestRunId == id do
                while Running
                    and AutoFest
                    and FestRunId == id
                    and EclipsePaused do

                    task.wait(0.1)
                end

                if not Running or not AutoFest or FestRunId ~= id then
                    break
                end

                local success, result = pcall(runOneDungeon, id)

                if EclipsePaused then
                    task.wait(0.1)
                    continue
                end

                if not Running or not AutoFest or FestRunId ~= id then
                    break
                end

                if not success then
                    status("ERROR FEST: " .. tostring(result))
                    task.wait(2)
                elseif not result then
                    status("FEST gagal | Coba ulang dari POS1...")
                    task.wait(2)
                else
                    status("FEST selesai | Dungeon berikutnya...")
                    task.wait(1)
                end
            end

            if FestRunId == id and not EclipsePaused then
                AutoFest = false

                setFestCombat(false)
                setToggle("AUTO FEST", false)

                status("AUTO FEST selesai / berhenti.")
            end
        end)

    else
        if AutoX7 then return end

        if AutoFest then
            stopMode("FEST")
        end

        ActiveMode = "X7"
        ActiveConfig = MODE_CONFIG.X7
        FLOOR_GLOW_POS = ActiveConfig.FLOOR_GLOW

        AutoX7 = true
        X7RunId = X7RunId + 1

        local id = X7RunId

        setToggle("AUTO X7", true)
        setToggle("AUTO FEST", false)

        status("Memulai AUTO X7...")

        task.spawn(function()
            while Running and AutoX7 and X7RunId == id do
                while Running
                    and AutoX7
                    and X7RunId == id
                    and EclipsePaused do

                    task.wait(0.1)
                end

                if not Running or not AutoX7 or X7RunId ~= id then
                    break
                end

                local success, result = pcall(runOneDungeon, id)

                if EclipsePaused then
                    task.wait(0.1)
                    continue
                end

                if not Running or not AutoX7 or X7RunId ~= id then
                    break
                end

                if not success then
                    status("ERROR X7: " .. tostring(result) .. " | Coba ulang 3 detik...")
                    task.wait(3)
                elseif not result then
                    status("Siklus X7 belum selesai | Ulang dari POS1 dalam 3 detik...")
                    task.wait(3)
                else
                    status("X7 selesai | Ulang dungeon berikutnya...")
                    task.wait(1)
                end
            end

            if X7RunId == id and not EclipsePaused then
                AutoX7 = false

                setFestCombat(false)
                setToggle("AUTO X7", false)

                status("AUTO X7 selesai / berhenti.")
            end
        end)
    end
end

local function stopFest()
    if AutoFest or (EclipsePaused and EclipseSavedFest) then
        stopMode("FEST")
    end
end

local function stopX7()
    if AutoX7 or (EclipsePaused and EclipseSavedX7) then
        stopMode("X7")
    end
end

