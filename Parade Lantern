local AutoPathRunning = false
local AutoPathTarget = nil
local AutoPathOldSpeed = nil

local function startAutoPath()
    if AutoPathRunning then return end
    AutoPathRunning = true

    task.spawn(function()
        local waypoints = nil
        local waypointIndex = 1
        local lastCompute = 0
        local lastTargetPosition = nil
        local lastMoveCommand = 0
        local currentDestination = nil
        local pathBlockedConnection = nil

        local function clearPath()
            waypoints = nil
            waypointIndex = 1
            currentDestination = nil
            lastTargetPosition = nil
            if pathBlockedConnection then
                pathBlockedConnection:Disconnect()
                pathBlockedConnection = nil
            end
        end

        while Running and AutoPathRunning do
            updateCharacter()

            local dungeonAttribute = Player:GetAttribute("Dungeon")
            local inDungeon = dungeonAttribute ~= nil
                and dungeonAttribute ~= false
                and dungeonAttribute ~= ""

            if not inDungeon or EclipsePaused or EclipsePriority or EclipseInRun
                or IsGoingToFloorGlow or BossPhaseActive or not (AutoFest or AutoX7) then
                clearPath()
                task.wait(0.2)
                continue
            end

            if not Root or not Humanoid or Humanoid.Health <= 0 then
                task.wait(0.2)
                continue
            end

            if not AutoPathOldSpeed then
                AutoPathOldSpeed = Humanoid.WalkSpeed
            end
            Humanoid.WalkSpeed = 50

            if not AutoPathTarget or not AutoPathTarget.Parent
                or isDead(AutoPathTarget) or not getMobRoot(AutoPathTarget) then
                AutoPathTarget = getNearestMob()
                clearPath()
                lastCompute = 0
            end

            local target = AutoPathTarget
            local targetRoot = target and getMobRoot(target)
            if not targetRoot then
                Humanoid:MoveTo(Root.Position)
                status("AUTO PATH | Mencari mob...")
                task.wait(0.25)
                continue
            end

            local distance = (Root.Position - targetRoot.Position).Magnitude
            if distance <= 7 then
                Humanoid:MoveTo(Root.Position)
                clearPath()
                status("AUTO PATH | Menyerang " .. target.Name)
                task.wait(0.18)
                continue
            end

            local targetMoved = not lastTargetPosition
                or (targetRoot.Position - lastTargetPosition).Magnitude >= 10
            local routeFinished = not waypoints or waypointIndex > #waypoints
            local shouldRecompute = routeFinished or targetMoved
                or (os.clock() - lastCompute >= 2.0 and not currentDestination)

            if shouldRecompute and os.clock() - lastCompute >= 0.35 then
                lastCompute = os.clock()
                lastTargetPosition = targetRoot.Position

                local path = PathfindingService:CreatePath({
                    AgentRadius = 2,
                    AgentHeight = 5,
                    AgentCanJump = true,
                    AgentJumpHeight = 8,
                    AgentMaxSlope = 45,
                    WaypointSpacing = 7,
                })

                local ok = pcall(function()
                    path:ComputeAsync(Root.Position, targetRoot.Position)
                end)

                if pathBlockedConnection then
                    pathBlockedConnection:Disconnect()
                    pathBlockedConnection = nil
                end

                if ok and path.Status == Enum.PathStatus.Success then
                    waypoints = path:GetWaypoints()
                    waypointIndex = math.min(2, #waypoints)
                    currentDestination = nil
                    pathBlockedConnection = path.Blocked:Connect(function(blockedIndex)
                        if blockedIndex >= waypointIndex then
                            lastCompute = 0
                            currentDestination = nil
                        end
                    end)
                else
                    waypoints = nil
                    waypointIndex = 1
                    currentDestination = targetRoot.Position
                end
            end

            local destination = targetRoot.Position
            local waypointAction = nil
            if waypoints and waypoints[waypointIndex] then
                local waypoint = waypoints[waypointIndex]
                destination = waypoint.Position
                waypointAction = waypoint.Action

                if (Root.Position - destination).Magnitude <= 4.5 then
                    waypointIndex += 1
                    currentDestination = nil
                    if waypoints[waypointIndex] then
                        destination = waypoints[waypointIndex].Position
                        waypointAction = waypoints[waypointIndex].Action
                    else
                        destination = targetRoot.Position
                    end
                end
            end

            if waypointAction == Enum.PathWaypointAction.Jump then
                Humanoid.Jump = true
            end

            -- Jangan reset MoveTo setiap 0.15s; itu bikin karakter tersendat.
            if not currentDestination
                or (currentDestination - destination).Magnitude > 2
                or os.clock() - lastMoveCommand >= 1.0 then
                Humanoid:MoveTo(destination)
                currentDestination = destination
                lastMoveCommand = os.clock()
            end

            status("AUTO PATH | " .. target.Name .. " | " .. math.floor(distance) .. " studs")
            task.wait(0.08)
        end

        if pathBlockedConnection then
            pathBlockedConnection:Disconnect()
            pathBlockedConnection = nil
        end

        updateCharacter()
        if Humanoid then
            Humanoid:MoveTo(Root and Root.Position or Vector3.zero)
            if AutoPathOldSpeed then
                Humanoid.WalkSpeed = AutoPathOldSpeed
            end
        end

        AutoPathOldSpeed = nil
        AutoPathTarget = nil
        AutoPathRunning = false
    end)
end

local function stopAutoPath()
    AutoPathRunning = false
    AutoPathTarget = nil
end

