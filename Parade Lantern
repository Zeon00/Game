-- ECLIPSE HELPERS
--============================================================

local function getCurrentEclipse()
    local attribute = Workspace:GetAttribute("EclipseDungeon")
    if not attribute then return nil, nil end

    local ok, config = pcall(function()
        return DungeonConfig.get(attribute)
    end)

    if not ok or not config or not config.Id then
        return nil, attribute
    end

    return config, attribute
end

local function getEclipseWorld(config)
    if not config then return nil end

    local ok, world = pcall(function()
        return DungeonConfig.worldOf(config)
    end)

    if not ok then return nil end
    return tonumber(world)
end

local function findUmbra()
    local enemies = Workspace:FindFirstChild("Enemies")
    local mob = enemies and enemies:FindFirstChild("Umbra the Sun-Eater")

    if mob and mob:IsA("Model") and not isDead(mob) then
        return mob
    end

    return nil
end

local function teleportToUmbra(mob)
    if not mob or not mob.Parent or isDead(mob) then return false end

    updateCharacter()
    if not Root then return false end

    local mobRoot = getMobRoot(mob)
    if not mobRoot then return false end

    return pcall(function()
        local destination = mobRoot.CFrame * CFrame.new(0, 0, 5)

        Root.CFrame = CFrame.lookAt(destination.Position, mobRoot.Position)
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function teleportEclipsePosition(position)
    updateCharacter()
    if not Root then return false end

    return pcall(function()
        Root.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function pauseModesForEclipse()
    if EclipsePaused then return end

    EclipseSavedFest = AutoFest
    EclipseSavedX7 = AutoX7

    EclipsePaused = true
    EclipsePriority = true

    if EclipseSavedFest then
        AutoFest = false
        FestRunId += 1
        setToggle("AUTO FEST", false)
    end

    if EclipseSavedX7 then
        AutoX7 = false
        X7RunId += 1
        setToggle("AUTO X7", false)
    end

    stopAutoPath()
    stopCombat()
    stopSkill()
    setAutoDodge(false)

    setToggle("SWING + HIT", false)
    setToggle("AUTO SKILL", false)
    setToggle("AUTO DODGE", false)

    updateCharacter()

    if Humanoid and Root then
        Humanoid:MoveTo(Root.Position)
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end

    status("ECLIPSE PRIORITY | FEST/X7 + SKILL + SWING + DODGE OFF")
end

local function restoreModesAfterEclipse()
    if not EclipsePaused then return end

    local resumeFest = EclipseSavedFest
    local resumeX7 = EclipseSavedX7

    stopCombat()
    stopSkill()
    setAutoDodge(false)

    setToggle("SWING + HIT", false)
    setToggle("AUTO SKILL", false)
    setToggle("AUTO DODGE", false)

    EclipseTarget = nil
    CurrentDungeonTarget = nil

    EclipsePaused = false
    EclipsePriority = false
    EclipseInRun = false

    AutoFest = false
    AutoX7 = false

    if resumeFest then
        setToggle("AUTO FEST", false)
        setToggle("AUTO X7", false)
        task.wait(0.2)
        startMode("FEST")
    elseif resumeX7 then
        setToggle("AUTO FEST", false)
        setToggle("AUTO X7", false)
        task.wait(0.2)
        startMode("X7")
    else
        setToggle("AUTO FEST", false)
        setToggle("AUTO X7", false)
    end

    EclipseSavedFest = false
    EclipseSavedX7 = false
    EclipseSavedCombat = false
    EclipseSavedSkill = false
    EclipseSavedDodge = false

    status("ECLIPSE SELESAI | Mode sebelumnya restart")
end

local function stopEclipse()
    AutoEclipse = false
    setToggle("AUTO ECLIPSE", false)

    if not EclipseInRun then
        EclipseRunId += 1
        restoreModesAfterEclipse()
        status("AUTO ECLIPSE OFF")
    else
        status("AUTO ECLIPSE OFF | Menyelesaikan Eclipse aktif...")
    end
end

--============================================================
-- AUTO ECLIPSE
--============================================================

local function startEclipse()
    if not Running or AutoEclipse then return end

    AutoEclipse = true
    EclipseRunId += 1

    local id = EclipseRunId
    setToggle("AUTO ECLIPSE", true)

    task.spawn(function()
        local function eclipseAlive()
            return Running
                and EclipseRunId == id
                and (AutoEclipse or EclipseInRun)
        end

        local function eclipseStatus(message)
            status("ECLIPSE | " .. tostring(message))
        end

        local function waitWorld(targetWorld)
            local currentWorld = tonumber(Player:GetAttribute("World")) or 1

            if currentWorld == targetWorld then
                return true
            end

            local lobbyName = currentWorld == 1 and "Lobby"
                or currentWorld == 2 and "Lobby2"

            if not lobbyName then
                eclipseStatus("World tidak dikenal: " .. tostring(currentWorld))
                return false
            end

            local lobby = Workspace:FindFirstChild(lobbyName)
            local zones = lobby and lobby:FindFirstChild("Zones")
            local portal = zones and zones:FindFirstChild("WorldPortal")

            if not portal then
                eclipseStatus("Portal World tidak ditemukan")
                return false
            end

            local portalPart

            if portal:IsA("BasePart") then
                portalPart = portal
            elseif portal:IsA("Model") then
                portalPart = portal.PrimaryPart
                    or portal:FindFirstChildWhichIsA("BasePart", true)
            else
                portalPart = portal:FindFirstChildWhichIsA("BasePart", true)
            end

            if not portalPart then return false end

            updateCharacter()
            if not Root then return false end

            eclipseStatus("Menuju portal World " .. currentWorld)
            Root.CFrame = portalPart.CFrame * CFrame.new(0, 3, 5)

            task.wait(1)
            if not eclipseAlive() then return false end

            local ok, result = pcall(function()
                return RequestRemote:InvokeServer("Travel", targetWorld)
            end)

            if not ok or result == false then
                eclipseStatus("Travel gagal: " .. tostring(result))
                return false
            end

            local deadline = os.clock() + 30

            while eclipseAlive() and os.clock() < deadline do
                currentWorld = tonumber(Player:GetAttribute("World")) or 1

                if currentWorld == targetWorld then
                    return true
                end

                task.wait(0.2)
            end

            return false
        end

        local function waitDungeonEntry()
            eclipseStatus("Menunggu masuk Eclipse...")

            while eclipseAlive() do
                if Player:GetAttribute("Dungeon") then
                    return true
                end

                task.wait(0.2)
            end

            return false
        end

        local function waitUmbra()
            eclipseStatus("Mencari Umbra the Sun-Eater...")

            while eclipseAlive() and Player:GetAttribute("Dungeon") do
                local mob = findUmbra()
                if mob then return mob end
                task.wait(0.2)
            end

            return nil
        end

        local function leaveCurrentDungeon()
            if not Player:GetAttribute("Dungeon") then
                return true
            end

            eclipseStatus("LeaveDungeon...")

            if not eclipseAlive() then return false end

            pcall(function()
                RequestRemote:InvokeServer("LeaveDungeon")
            end)

            local deadline = os.clock() + 20

            while eclipseAlive()
                and Player:GetAttribute("Dungeon")
                and os.clock() < deadline do

                task.wait(0.2)
            end

            return not Player:GetAttribute("Dungeon")
        end

        while eclipseAlive() and AutoEclipse do
            local config, attribute = getCurrentEclipse()

            if not config then
                eclipseStatus("Memantau EclipseDungeon...")
                task.wait(0.8)
                continue
            end

            local targetWorld = getEclipseWorld(config)

            if targetWorld ~= 1 and targetWorld ~= 2 then
                eclipseStatus("World Eclipse tidak valid")
                task.wait(2)
                continue
            end

            EclipseInRun = true
            pauseModesForEclipse()

            eclipseStatus("Eclipse terdeteksi: " .. tostring(attribute))

            if not leaveCurrentDungeon() then
                eclipseStatus("LeaveDungeon gagal | Retry")
                task.wait(2)
                EclipseInRun = false
                restoreModesAfterEclipse()
                continue
            end

            if not eclipseAlive() then break end

            if not waitWorld(targetWorld) then
                task.wait(2)
                EclipseInRun = false
                restoreModesAfterEclipse()
                continue
            end

            local latestConfig = getCurrentEclipse()

            if not latestConfig then
                EclipseInRun = false
                restoreModesAfterEclipse()
                task.wait(1)
                continue
            end

            local latestWorld = getEclipseWorld(latestConfig)

            if latestWorld ~= targetWorld then
                EclipseInRun = false
                restoreModesAfterEclipse()
                task.wait(1)
                continue
            end

            if Player:GetAttribute("Dungeon") then
                if not leaveCurrentDungeon() then
                    task.wait(2)
                    continue
                end
            end

            eclipseStatus("Memanggil EclipseEnter...")

            local enterOK, enterResult = pcall(function()
                return PlayerState.request("EclipseEnter", latestConfig.Id)
            end)

            if not enterOK or enterResult == false then
                eclipseStatus("EclipseEnter gagal")
                EclipseInRun = false
                restoreModesAfterEclipse()
                task.wait(3)
                continue
            end

            if not waitDungeonEntry() then break end
            if not eclipseAlive() then break end

            local umbra = waitUmbra()
            if not eclipseAlive() then break end

            if umbra then
                EclipseTarget = umbra
                CurrentDungeonTarget = umbra

                eclipseStatus("Umbra ditemukan | TP ke Umbra...")

                if not teleportToUmbra(umbra) then
                    for _ = 1, 10 do
                        if not eclipseAlive() or isDead(umbra) then break end
                        if teleportToUmbra(umbra) then break end
                        task.wait(0.3)
                    end
                end

                startCombat()
                startSkill()
                setAutoDodge(true)

                setToggle("SWING + HIT", true)
                setToggle("AUTO SKILL", true)

                eclipseStatus("Combat Umbra aktif...")

                while eclipseAlive() and umbra.Parent and not isDead(umbra) do
                    task.wait(0.2)
                end

                if not eclipseAlive() then break end

                eclipseStatus("Umbra tumbang | Menunggu model hilang...")

                local disappearDeadline = os.clock() + 30

                while eclipseAlive() and os.clock() < disappearDeadline do
                    local enemies = Workspace:FindFirstChild("Enemies")

                    if not (enemies and enemies:FindFirstChild("Umbra the Sun-Eater")) then
                        break
                    end

                    task.wait(0.15)
                end
            else
                eclipseStatus("Umbra tidak ditemukan")
            end

            if not eclipseAlive() then break end

            EclipseTarget = nil
            CurrentDungeonTarget = nil

            stopCombat()
            stopSkill()
            setAutoDodge(false)

            if Player:GetAttribute("Dungeon") then
                eclipseStatus("LeaveDungeon Eclipse...")

                local left = false

                for _ = 1, 5 do
                    if not eclipseAlive() then break end

                    if not Player:GetAttribute("Dungeon") then
                        left = true
                        break
                    end

                    pcall(function()
                        RequestRemote:InvokeServer("LeaveDungeon")
                    end)

                    local deadline = os.clock() + 5

                    while eclipseAlive()
                        and Player:GetAttribute("Dungeon")
                        and os.clock() < deadline do

                        task.wait(0.2)
                    end
                end

                left = left or not Player:GetAttribute("Dungeon")

                if not left then
                    eclipseStatus("LeaveDungeon retry...")
                    task.wait(2)
                    continue
                end
            end

            if not eclipseAlive() then break end

            eclipseStatus("Berhasil keluar dari Eclipse")

            if targetWorld == 1 then
                local travelled = false

                while eclipseAlive() and not travelled do
                    travelled = waitWorld(2)

                    if not travelled then
                        task.wait(2)
                    end
                end
            end

            if not eclipseAlive() then break end

            task.wait(2)

            local world2Position = Vector3.new(
                0,
                4003.497802734375,
                24.5
            )

            eclipseStatus("Menuju posisi World 2...")
            teleportEclipsePosition(world2Position)

            task.wait(3)

            if not eclipseAlive() then break end

            EclipseInRun = false
            restoreModesAfterEclipse()

            eclipseStatus("Selesai | Mode sebelumnya restart")
            task.wait(1)
        end

        EclipseInRun = false
        restoreModesAfterEclipse()

        if EclipseRunId == id then
            AutoEclipse = false
            setToggle("AUTO ECLIPSE", false)
        end
    end)
end

--============================================================
-- WAIT BOSS DEFEATED
--============================================================

local function waitBossDefeated(id)
    status("Menunggu " .. tostring(ActiveConfig.BOSS) .. "...")

    local boss
    local confirmedAlive = false
    local waitStarted = os.clock()
    local emptySince = nil
    local spawnGrace = 12 -- beri waktu boss muncul setelah FloorGlow
    local emptyConfirm = 1.5

    local function enemiesAreEmpty()
        local folder = Workspace:FindFirstChild("Enemies")
        if not folder then return false end
        return #folder:GetChildren() == 0
    end

    -- Fase awal: cari boss, tetapi jangan menunggu selamanya jika boss
    -- sudah mati/hilang sebelum script sempat menangkap modelnya.
    while alive(id) do
        boss = getBoss()

        if boss and boss.Parent then
            local hp = getBossHealth(boss)
            if hp ~= nil and hp <= 0 then
                status("Boss HP 0 | BOSS KALAH!")
                return true
            end

            confirmedAlive = true
            break
        end

        if enemiesAreEmpty() then
            emptySince = emptySince or os.clock()
            if os.clock() - waitStarted >= spawnGrace
                and os.clock() - emptySince >= emptyConfirm then
                status("workspace.Enemies kosong | Boss dianggap selesai")
                return true
            end
        else
            emptySince = nil
        end

        task.wait(0.15)
    end

    if not alive(id) then return false end

    status("Boss ditemukan | Menunggu posisi Boss Room...")
    startBossOrbit(id, boss)

    while alive(id) do
        if not boss or not boss.Parent then
            if confirmedAlive then
                status("Boss menghilang | Dianggap kalah")
                return true
            end

            boss = getBoss()
            if not boss then
                if enemiesAreEmpty() then
                    emptySince = emptySince or os.clock()
                    if os.clock() - emptySince >= emptyConfirm then
                        status("workspace.Enemies kosong | Boss dianggap selesai")
                        return true
                    end
                else
                    emptySince = nil
                end
                task.wait(0.15)
                continue
            end

            startBossOrbit(id, boss)
        end

        local hp = getBossHealth(boss)
        if hp ~= nil then
            if hp <= 0 then
                status("Boss HP 0 | BOSS KALAH!")
                return true
            end
            confirmedAlive = true
        end

        task.wait(0.15)
    end

    return false
end

--==================================================
-- BOSS PHASE | ORBIT + ENEMIES EMPTY 5 SECONDS
-- NO BOSS NAME DETECTION
-- NO FLOOR GLOW SEARCH AFTER TELEPORT
--==================================================

local function finishBossPhase(id)
    if not alive(id) then return false end

    -- FLOOR GLOW SUDAH DICAPAI
    -- STOP DODGE DAN AUTO PATH
    setAutoDodge(false)
    stopAutoPath()

    -- AKTIFKAN ORBIT LANGSUNG, TANPA MENUNGGU NAMA BOSS
    BossPhaseActive = true
    BossPhaseDelayDone = true

    setToggle("AUTO ORBIT", true)
    startBossOrbit(id, nil)

    status("FLOOR GLOW SELESAI | AUTO ORBIT AKTIF")

    -- TIDAK ADA LAGI PENCARIAN FLOOR GLOW DI FUNGSI INI
    -- CEK FOLDER ENEMIES SAJA
    local emptySince = nil

    while alive(id) do
        local enemies = Workspace:FindFirstChild("Enemies")

        if enemies then
            local count = #enemies:GetChildren()

            if count == 0 then
                if not emptySince then
                    emptySince = os.clock()
                    status("ENEMIES KOSONG | MENUNGGU 5 DETIK")
                end

                local elapsed = os.clock() - emptySince

                if elapsed >= 3 then
                    break
                end
            else
                emptySince = nil
                status("AUTO ORBIT AKTIF | ENEMIES: " .. count)
            end
        else
            -- Folder belum ada: jangan dianggap selesai
            emptySince = nil
            status("MENUNGGU WORKSPACE.ENEMIES...")
        end

        task.wait(0.15)
    end

    if not alive(id) then return false end

    -- ENEMIES KOSONG SELAMA 5 DETIK
    -- MATIKAN ORBIT
    BossPhaseActive = false
    setToggle("AUTO ORBIT", false)

    local stopDeadline = os.clock() + 2
    while BossOrbitRunning and os.clock() < stopDeadline do
        task.wait(0.05)
    end

    if not alive(id) then return false end

    -- CARI BOSSEXIT SAJA
    local bossExit = getDungeonObject({
        "Markers",
        "BossExit"
    })

    if not bossExit then
        status("ERROR | BOSSEXIT TIDAK DITEMUKAN")
        return false
    end

    local exitPosition = getObjectPosition(bossExit)

    if not exitPosition then
        status("ERROR | POSISI BOSSEXIT TIDAK DITEMUKAN")
        return false
    end

    updateCharacter()

    if not Root then return false end

    status("ENEMIES KOSONG 5 DETIK | TP BOSSEXIT")

    local oldCF = Root.CFrame

    Root.CFrame = CFrame.new(exitPosition + Vector3.new(0, 3, 0))
        * (oldCF - oldCF.Position)

    Root.AssemblyLinearVelocity = Vector3.zero
    Root.AssemblyAngularVelocity = Vector3.zero

    task.wait(0.5)

    if not alive(id) then return false end

    BossPhaseActive = false
    BossPhaseDelayDone = false
    setToggle("AUTO ORBIT", false)

    status("BOSSEXIT BERHASIL")
    return true
end
--============================================================
-- RUN ONE DUNGEON
--============================================================

local function runOneDungeon(id)
    if BossPhaseActive then
        return finishBossPhase(id)
    end

    BossPhaseDelayDone = false
    updateCharacter()

    if not Root then return false end

    if ActiveMode == "X7" then
        X7BlockPassed = false
    else
        FestBlockPassed = false
    end

    status("[" .. ActiveMode .. "] Teleport POS1...")
    Root.CFrame = CFrame.new(ActiveConfig.POS1 + ActiveConfig.POS1_OFFSET)

    task.wait(0.3)
    if not alive(id) then return false end

    status("[" .. ActiveMode .. "] Lari menuju POS2...")

    if not moveToPosition(
        ActiveConfig.POS2,
        function()
            return alive(id)
        end,
        "POS2",
        5
    ) then
        return false
    end

    task.wait(2)
    if not alive(id) then return false end

    status("EnterDungeon " .. ActiveConfig.DUNGEON
        .. " | Star " .. tostring(ActiveConfig.COUNT) .. "...")

    local ok, result = pcall(function()
        return RequestRemote:InvokeServer(
            "EnterDungeon",
            ActiveConfig.DUNGEON,
            ActiveConfig.COUNT
        )
    end)

    if not ok then
        status("EnterDungeon error: " .. tostring(result))
        return false
    end

    if result == false then
        status("EnterDungeon ditolak")
        return false
    end

    if not alive(id) or EclipsePaused or EclipsePriority or EclipseInRun then
        return false
    end

    setFestCombat(true)
    startAutoPath()

    status(ActiveConfig.DUNGEON .. " masuk | Auto Hit + Skill ON")
    task.wait(0.3)

    local floorGlow

    while alive(id) do
        updateCharacter()

        local dungeonBar = PlayerGui:FindFirstChild("GameUI")
            and PlayerGui.GameUI:FindFirstChild("DungeonBar")

        local progress = dungeonBar and dungeonBar:FindFirstChild("Progress")
        local progressContent = ""

        if progress then
            if progress:IsA("TextLabel") or progress:IsA("TextButton") then
                progressContent ..= " " .. tostring(progress.Text)
            end

            for _, obj in ipairs(progress:GetDescendants()) do
                if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                    progressContent ..= " " .. tostring(obj.Text)
                end
            end
        end

        local normalized = string.upper(progressContent)
            :gsub("%s+", "")
            :gsub("[^%w!]", "")

        local progressOpen =
            string.find(normalized, "BOSSOPEN", 1, true)
            or string.find(normalized, "OPEN!", 1, true)

        local spawnedBoss = getBoss()

        if spawnedBoss then
            BossPhaseActive = true
            BossPhaseDelayDone = false
            activateBossPhaseDodge()
            break
        end

        if progressOpen then
            status("BOSS OPEN! Mencari FloorGlow...")

            floorGlow = getActiveFloorGlow()

            if floorGlow then
                status("BOSS OPEN! FloorGlow ditemukan: "
                    .. ActiveConfig.DUNGEON)
                break
            end

            status("FloorGlow belum muncul | Mencari ulang...")
        end

        task.wait(0.15)
    end

    if not alive(id) then return false end

    do
        -- Boss bisa spawn lebih dulu dari pembacaan progress UI.
        -- Tetap cari dan TP ke FloorGlow sebelum mulai orbit boss.
        floorGlow = floorGlow or getActiveFloorGlow()
        local glowDeadline = os.clock() + 15
        while alive(id) and not floorGlow and os.clock() < glowDeadline do
            floorGlow = getActiveFloorGlow()
            if not floorGlow then task.wait(0.2) end
        end

        local glowPosition = getObjectPosition(floorGlow)

        if not glowPosition then
            status("FloorGlow tidak ditemukan di Workspace.Dungeons."
                .. ActiveConfig.DUNGEON .. ".BossDoor.FloorGlow")
            return false
        end

        FLOOR_GLOW_POS = glowPosition

        -- Teleport langsung ke FloorGlow, bukan jalan jauh ke koordinat lama.
        updateCharacter()

        if not Root then return false end

        IsGoingToFloorGlow = true
        stopAutoPath()

        status("TP ke FloorGlow " .. ActiveConfig.DUNGEON .. "...")

        local oldCF = Root.CFrame
        local targetPosition = floorGlow.Position + Vector3.new(0, 3, 0)

        Root.CFrame = CFrame.new(targetPosition)
            * (oldCF - oldCF.Position)

        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero

        -- Satu kali teleport ke FloorGlow. Setelah itu game/server yang
        -- memindahkan karakter ke Boss Room; script tidak TP ulang.
        task.wait(0.35)
        updateCharacter()

        local verified = Root
            and (Root.Position - floorGlow.Position).Magnitude <= 8

        IsGoingToFloorGlow = false

        if not verified then
            status("TP FloorGlow tidak terkonfirmasi")
            return false
        end

        BossPhaseActive = true
        BossPhaseDelayDone = false

        -- finishBossPhase menunggu 2 detik, lalu menyalakan orbit otomatis.
        status("FloorGlow tersentuh | Menunggu 2 detik sebelum AUTO ORBIT...")
    end

    stopAutoPath()
    setAutoDodge(false)

    return finishBossPhase(id)
end

--============================================================
-- STOP MODE
--============================================================

local function stopMode(mode)
    if mode == "FEST" then
        AutoFest = false
        FestRunId += 1
        setToggle("AUTO FEST", false)
    elseif mode == "X7" then
        AutoX7 = false
        X7RunId += 1
        setToggle("AUTO X7", false)
    end

    if EclipsePaused then
        if mode == "FEST" then
            EclipseSavedFest = false
        else
            EclipseSavedX7 = false
        end
    else
        stopAutoPath()
        setFestCombat(false)
    end

    BossPhaseActive = false
    BossPhaseDelayDone = false
    IsGoingToFloorGlow = false
    setToggle("AUTO ORBIT", false)

    updateCharacter()

    if Humanoid and Root then
        Humanoid:MoveTo(Root.Position)
    end

    if not EclipsePaused then
        ModeStopping = true
        ModeStopId += 1

        local stopId = ModeStopId

        status("AUTO " .. mode .. " OFF | Keluar dungeon...")

        task.spawn(function()
            if Player:GetAttribute("Dungeon") then
                for _ = 1, 8 do
                    if not Running or ModeStopId ~= stopId then
                        return
                    end

                    if not Player:GetAttribute("Dungeon") then
                        break
                    end

                    pcall(function()
                        RequestRemote:InvokeServer("LeaveDungeon")
                    end)

                    local deadline = os.clock() + 2

                    while Running
                        and ModeStopId == stopId
                        and Player:GetAttribute("Dungeon")
                        and os.clock() < deadline do

                        task.wait(0.1)
                    end
                end
            end

            if ModeStopId == stopId then
                ModeStopping = false
                status("AUTO " .. mode .. " OFF | Siap mulai ulang")

                local pending = PendingMode
                PendingMode = nil

                if pending and Running then
                    task.wait(0.2)
                    startMode(pending)
                end
            end
        end)
    else
        status("AUTO " .. mode .. " dihentikan")
    end
end

--============================================================
-- START MODE
--============================================================

startMode = function(mode)
    if ModeStopping then
        PendingMode = mode

        setToggle("AUTO FEST", mode == "FEST")
        setToggle("AUTO X7", mode == "X7")

        status("Menunggu LeaveDungeon | " .. mode .. " akan mulai")
        return
    end

    if EclipsePaused or EclipsePriority then
        status("ECLIPSE PRIORITY | FEST/X7 menunggu")
        return
    end

    if mode == "FEST" then
        if AutoFest then return end

        if AutoX7 then
            stopMode("X7")
            PendingMode = "FEST"
            return
        end

        ActiveMode = "FEST"
        ActiveConfig = MODE_CONFIG.FEST
        FLOOR_GLOW_POS = ActiveConfig.FLOOR_GLOW

        AutoFest = true
        FestRunId += 1

        local id = FestRunId

        setToggle("AUTO FEST", true)
        setToggle("AUTO X7", false)

        status("Memulai AUTO FEST...")

        task.spawn(function()
            while Running and AutoFest and FestRunId == id do
                while Running
                    and AutoFest
                    and FestRunId == id
                    and EclipsePaused do

                    task.wait(0.1)
                end

                if not Running or not AutoFest or FestRunId ~= id then
                    break
                end

                local success, result = pcall(runOneDungeon, id)

                if EclipsePaused then
                    task.wait(0.1)
                    continue
                end

                if not Running or not AutoFest or FestRunId ~= id then
                    break
                end

                if not success then
                    status("ERROR FEST: " .. tostring(result))
                    task.wait(2)
                elseif not result then
                    status("FEST gagal | Ulang POS1...")
                    task.wait(2)
                else
                    status("FEST selesai | Dungeon berikutnya...")
                    task.wait(1)
                end
            end

            if FestRunId == id and not EclipsePaused then
                AutoFest = false
                setFestCombat(false)
                setToggle("AUTO FEST", false)
                status("AUTO FEST berhenti")
            end
        end)

    elseif mode == "X7" then
        if AutoX7 then return end

        local selectedConfig, err = resolveX7Config()

        if not selectedConfig then
            status("X7 ERROR | " .. tostring(err))
            setToggle("AUTO X7", false)
            return
        end

        if AutoFest then
            stopMode("FEST")
            PendingMode = "X7"
            return
        end

        ActiveMode = "X7"
        ActiveConfig = selectedConfig
        FLOOR_GLOW_POS = ActiveConfig.FLOOR_GLOW

        AutoX7 = true
        X7RunId += 1

        local id = X7RunId

        setToggle("AUTO X7", true)
        setToggle("AUTO FEST", false)

        status("AUTO X7 | Dungeon ID " .. X7DungeonInput
            .. " | Dungeon " .. ActiveConfig.DUNGEON
            .. " | Star " .. ActiveConfig.COUNT)

        task.spawn(function()
            while Running and AutoX7 and X7RunId == id do
                while Running
                    and AutoX7
                    and X7RunId == id
                    and EclipsePaused do

                    task.wait(0.1)
                end

                if not Running or not AutoX7 or X7RunId ~= id then
                    break
                end

                local success, result = pcall(runOneDungeon, id)

                if EclipsePaused then
                    task.wait(0.1)
                    continue
                end

                if not Running or not AutoX7 or X7RunId ~= id then
                    break
                end

                if not success then
                    status("ERROR X7: " .. tostring(result) .. " | Retry...")
                    task.wait(3)
                elseif not result then
                    status("X7 belum selesai | Ulang POS1...")
                    task.wait(3)
                else
                    status("X7 selesai | Dungeon berikutnya...")
                    task.wait(1)
                end
            end

            if X7RunId == id and not EclipsePaused then
                AutoX7 = false
                setFestCombat(false)
                setToggle("AUTO X7", false)
                status("AUTO X7 berhenti")
            end
        end)
    end
end

local function stopFest()
    if AutoFest or (EclipsePaused and EclipseSavedFest) then
        stopMode("FEST")
    end
end

local function stopX7()
    if AutoX7 or (EclipsePaused and EclipseSavedX7) then
        stopMode("X7")
    end
end

