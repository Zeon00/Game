}

local function getEventShopData()
    if not EventKit then return nil end

    local ok, data = pcall(function()
        return EventKit.latest()
    end)

    if ok and type(data) == "table"
        and data.Shop and data.Shop.List then
        return data
    end

    return nil
end


local function teleportToEventShopZone()
    updateCharacter()

    if not Root then return false end

    local lobby = Workspace:FindFirstChild("Lobby2")
    local festival = lobby and lobby:FindFirstChild("Festival")
    local pad = festival and festival:FindFirstChild("EventShopPad")

    if not pad then
        warn("[RESTOCK] Lobby2.Festival.EventShopPad tidak ditemukan")
        return false
    end

    local targetPosition

    if pad:IsA("BasePart") then
        -- Tepat di atas EventShopPad.
        targetPosition = pad.Position
            + Vector3.new(0, pad.Size.Y / 2 + 3, 0)

    elseif pad:IsA("Model") then
        local cf, size = pad:GetBoundingBox()
        targetPosition = cf.Position
            + Vector3.new(0, size.Y / 2 + 3, 0)

    else
        local part = pad:FindFirstChildWhichIsA("BasePart", true)
        if not part then return false end

        targetPosition = part.Position
            + Vector3.new(0, part.Size.Y / 2 + 3, 0)
    end

    local oldCF = Root.CFrame

    Root.CFrame =
        CFrame.new(targetPosition) * (oldCF - oldCF.Position)

    Root.AssemblyLinearVelocity = Vector3.zero
    Root.AssemblyAngularVelocity = Vector3.zero

    task.wait(0.2)

    return true
end


local function buyAllEventItems()
    local boughtCount = 0
    local failedCount = 0

    for _, itemKey in ipairs(EVENT_BUY_KEYS) do
        local ok, result, response = pcall(function()
            return RequestRemote:InvokeServer("EventBuy", itemKey)
        end)

        if ok and result ~= false then
            boughtCount += 1
            print("[RESTOCK] REQUEST:", itemKey, result)
        else
            failedCount += 1
            warn("[RESTOCK] GAGAL:", itemKey, result or response)
        end
    end

    status(string.format(
        "RESTOCK | Request: %d/6 | Gagal: %d",
        boughtCount,
        failedCount
    ))
end


local function startAutoRestock()
    if AutoRestock then return end

    AutoRestock = true
    RestockRunId += 1

    local runId = RestockRunId
    local preparedRestock = nil
    local attemptedRestock = nil

    interruptedRestockKey = nil

    setToggle("AUTO RESTOCK", true)
    status("AUTO RESTOCK ON | Memantau timer...")

    task.spawn(function()
        while Running and AutoRestock and RestockRunId == runId do
            local eventData = getEventShopData()

            if eventData then
                local now = Workspace:GetServerTimeNow()

                local ok, slotId, _, nextRestock = pcall(function()
                    return EventKit.Shop.slot(eventData, now)
                end)

                if ok and type(nextRestock) == "number" then
                    local remaining = nextRestock - now
                    local restockKey =
                        tostring(slotId) .. ":" .. tostring(nextRestock)

                    -- TERSISA 5 DETIK:
                    -- PAUSE MODE, LEAVE DUNGEON, LALU TP KE SHOP.
                    if remaining <= RESTOCK_PREPARE_SECONDS
                        and remaining > 0 then

                        if interruptedRestockKey ~= restockKey then
                            interruptedRestockKey = restockKey
                            RestockPaused = true

                            status("RESTOCK 5 DETIK | Pause FEST/X7 | Leave Dungeon...")

                            if pauseDungeonForRestock then
                                pcall(pauseDungeonForRestock)
                            end
                        end

                        -- Coba TP sampai berhasil.
                        if preparedRestock ~= restockKey then
                            if teleportToEventShopZone() then
                                preparedRestock = restockKey
                                status("DI EVENT SHOP ZONE | Menunggu restock...")
                            else
                                status("Gagal TP EventShopZone | Mencoba lagi...")
                            end
                        end
                    end

                    -- WAKTU RESTOCK TIBA: BORONG ITEM.
                    if remaining <= 0
                        and attemptedRestock ~= restockKey then

                        attemptedRestock = restockKey

                        status("RESTOCK TIBA | BORONG 6 ITEM!")

                        if not teleportToEventShopZone() then
                            status("Gagal TP EventShopZone | Coba lagi...")
                            attemptedRestock = nil
                        else
                            local buyOK, buyError = pcall(buyAllEventItems)

                            if not buyOK then
                                warn("[RESTOCK] ERROR:", buyError)
                                status("RESTOCK ERROR: " .. tostring(buyError))
                            end

                            -- MODE SEBELUMNYA LANJUT LAGI.
                            preparedRestock = nil
                            interruptedRestockKey = nil
                            RestockPaused = false

                            status("RESTOCK SELESAI | Melanjutkan mode sebelumnya...")
                        end
                    end
                end
            end

            task.wait(0.03)
        end
    end)
end

local function stopAutoRestock()
    AutoRestock = false
    RestockRunId += 1

    RestockPaused = false
    RestockLeaving = false
    interruptedRestockKey = nil

    setToggle("AUTO RESTOCK", false)
    status("AUTO RESTOCK OFF")
end


--MOB HELPERS

local function getMobRoot(mob)

    if not mob or not mob:IsA("Model") then return nil end

    return mob:FindFirstChild("HumanoidRootPart")

        or mob.PrimaryPart

        or mob:FindFirstChild("RootPart")

end

local function getHealth(mob)

    if not mob then return nil end

    local hum = mob:FindFirstChildOfClass("Humanoid")

    if hum then return hum.Health end

    local health = mob:FindFirstChild("Health")

    if health and health:IsA("NumberValue") then

        return health.Value

    end

    local attr = mob:GetAttribute("Health")

    if typeof(attr) == "number" then

        return attr

    end

    return nil

end

local function isDead(mob)

    if not mob or not mob.Parent then return true end

    if mob:GetAttribute("Dead") == true then return true end

    local dead = mob:FindFirstChild("Dead")

    if dead and dead:IsA("BoolValue") and dead.Value then

        return true

    end

    local hp = getHealth(mob)

    return hp ~= nil and hp <= 0

end

local function validOwner(mob)

    local owner = mob:GetAttribute("Owner")

    if owner == nil then

        local obj = mob:FindFirstChild("Owner")

        if obj and obj:IsA("ValueBase") then

            owner = obj.Value

        end

    end

    if owner == nil or owner == "" or owner == 0 then

        return true

    end

    return owner == Player.UserId or owner == Player.Name

end

local function getAllMobs()

    local folder = Workspace:FindFirstChild("Enemies")

    local result = {}

    if not folder then return result end

    for _, mob in ipairs(folder:GetChildren()) do

        if mob:IsA("Model")

            and not isDead(mob)

            and validOwner(mob)

            and getMobRoot(mob) then

            table.insert(result, mob)

        end

    end

    return result

end

local function getNearestMob()

    updateCharacter()

    if not Root then return nil end

    local bestMob

    local bestDistance = math.huge

    for _, mob in ipairs(getAllMobs()) do

        local mobRoot = getMobRoot(mob)

        if mobRoot then

            local distance = (Root.Position - mobRoot.Position).Magnitude

            if distance < bestDistance then

                bestDistance = distance

                bestMob = mob

            end

        end

    end

    return bestMob

end

--OBJECT HELPERS

local function getObjectPosition(object)

    if not object then return nil end

    if object:IsA("BasePart") then

        return object.Position

    end

    if object:IsA("Model") then

        return object:GetPivot().Position

    end

    local part = object:FindFirstChildWhichIsA("BasePart", true)

    return part and part.Position or nil

end

local function getDungeonObject(path)

    local current = Workspace:FindFirstChild("Dungeons")

    if not current then return nil end

    current = current:FindFirstChild(ActiveConfig.DUNGEON)

    if not current then return nil end

    for _, name in ipairs(path) do

        current = current:FindFirstChild(name)

        if not current then return nil end

    end

    return current

end

--DIRECT MOVETO

local function moveToPosition(position, isActive, label, stopDistance)

    stopDistance = stopDistance or 5

    updateCharacter()

    if not Root or not Humanoid then return false end

    local oldSpeed = Humanoid.WalkSpeed

    Humanoid.WalkSpeed = math.max(oldSpeed, ActiveConfig.WALK_SPEED)

    local arrived = false

    local lastMove = 0

    while isActive() do

        updateCharacter()

        if not Root or not Humanoid or Humanoid.Health <= 0 then

            break

        end

        local distance = (Root.Position - position).Magnitude

        if distance <= stopDistance then

            arrived = true

            break

        end

        if os.clock() - lastMove >= 1 then

            Humanoid:MoveTo(position)

            lastMove = os.clock()

        end

        status(label .. " | " .. math.floor(distance) .. " studs")

        task.wait(0.12)

    end

    updateCharacter()

    if Humanoid then

        Humanoid:MoveTo(Root and Root.Position or position)

        Humanoid.WalkSpeed = oldSpeed

    end

    return arrived

end

